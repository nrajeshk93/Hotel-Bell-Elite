# Copy to .env and adjust. Required for HTTPS / Android WebView session cookies.
FLASK_ENV=production
SESSION_COOKIE_SECURE=1
# python app.py defaults debug OFF. Set 1 for local auto-reload.
FLASK_DEBUG=0

# Set a long random value in production (the app never uses a public default).
SECRET_KEY=change-me-to-a-long-random-string

# Trust X-Forwarded-For / X-Forwarded-Proto for a single proxy hop (nginx).
# Leave 0 for direct local access so lockout uses remote_addr.
# Behind nginx on AWS set TRUST_PROXY=1 so HTTPS cookies stay Secure.
TRUST_PROXY=0

# Public base URL for unlock emails on production (no trailing slash).
# Local/dev logins ignore this and use the request host so the link hits the same DB.
APP_BASE_URL=https://your-production-host.example

# SMTP for unlock emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-whatsapp-verify-token
# Required on AWS. Unsigned webhook POSTs are rejected without it.
WHATSAPP_APP_SECRET=
WHATSAPP_INDENT_APPROVAL_TEMPLATE=indent_approval_v2
WHATSAPP_INDENT_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_INDENT_APPROVER_NAME=
# Comma-separated E.164 / local numbers
WHATSAPP_INDENT_APPROVER_NUMBERS=
# Max successful indent-approval WhatsApp sends per rolling 24 hours (default 10)
WHATSAPP_INDENT_DAILY_CAP=10
# Purchase Order send to supplier — approved Meta template with Accept / Reject buttons
WHATSAPP_PO_TEMPLATE=purchase_order_hotel_bell_elite
WHATSAPP_PO_TEMPLATE_LANGUAGE=en
# One product per line: set to 10 after approving a template with {{3}}…{{12}}
# each on its own line (Meta forbids \n inside a single variable). 0 = legacy {{3}} blob.
WHATSAPP_PO_TEMPLATE_ITEM_SLOTS=0
# Safety: set to 1 to block all live Meta HTTP (messages + media upload)
# WHATSAPP_DRY_RUN=1
# Unit tests with Flask TESTING already block live sends unless this is 1
# WHATSAPP_ALLOW_IN_TESTS=0
# Host that receives Meta webhooks. Live Send for Approval from any other host
# is blocked so tokens are not written to a DB the webhook cannot see.
WHATSAPP_INDENT_PUBLIC_HOST=

# Hub mirroring permanently disabled (do not enable — caused production self-mirror lag).
# HUB_MIRROR_URL=
# HUB_MIRROR_TOKEN=

# Asia Tech Extranet (read-only reservations sync). Prefer these over Hotel Settings.
# Never commit real secrets. Base URL from vendor PDF.
ASIA_TECH_BASE_URL=https://provider.asiatech.in
ASIA_TECH_USERNAME=
ASIA_TECH_PASSWORD=
ASIA_TECH_HOTEL_ID=
# Channel Manager browser login (Bookings → Booking Reports → Check In).
# Required to sync stays by check-in date; JSON API alone only covers ~10 days of activity.
ASIA_TECH_CM_EMAIL=
ASIA_TECH_CM_PASSWORD=
