# Copy to .env and adjust. Required for HTTPS / Android WebView session cookies.
FLASK_ENV=production
SESSION_COOKIE_SECURE=1
# python app.py defaults debug OFF. Set 1 for local auto-reload.
FLASK_DEBUG=0

# Set a long random value in production (the app never uses a public default).
SECRET_KEY=change-me-to-a-long-random-string

# Trust X-Forwarded-For / X-Forwarded-Proto for a single proxy hop (nginx).
# Leave 0 for direct local access so lockout uses remote_addr.
# Behind nginx on AWS set TRUST_PROXY=1 so HTTPS cookies stay Secure.
TRUST_PROXY=0

# Public base URL for unlock emails on production (no trailing slash).
# Local/dev logins ignore this and use the request host so the link hits the same DB.
APP_BASE_URL=https://your-production-host.example

# SMTP for unlock emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WABA_ID=
# Meta phone_number_id for Hotel Bell Elite sender +91 96112 32344
# (E.164 +919611232344). Outbound "from" is this id in the Graph URL, not body digits.
# Live Graph (shared WABA): 1241737459022736 = +91 96112 32344 (Hotel Bell Elite);
# 1213272865195663 = +91 94742 41325 (Neeraj Tex) — do NOT use for HBE sends.
WHATSAPP_PHONE_NUMBER_ID=1241737459022736
# Optional: refuse live send if Graph display number for the id above != this E.164.
# Default in code is +919611232344 when unset; set empty to disable the check.
WHATSAPP_SENDER_E164=+919611232344
# WHATSAPP_SKIP_SENDER_VERIFY=1
WHATSAPP_VERIFY_TOKEN=change-me-whatsapp-verify-token
# Required on AWS. Unsigned webhook POSTs are rejected without it.
WHATSAPP_APP_SECRET=
WHATSAPP_INDENT_APPROVAL_TEMPLATE=indent_approval_v2
WHATSAPP_INDENT_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_INDENT_APPROVER_NAME=
# Comma-separated E.164 / local numbers
WHATSAPP_INDENT_APPROVER_NUMBERS=
# Max successful indent-approval WhatsApp sends per rolling 24 hours (default 10)
WHATSAPP_INDENT_DAILY_CAP=10
# Lifetime install-wide live WhatsApp send cap (License page "WhatsApp available limit").
WHATSAPP_MESSAGE_LIMIT=1000
# POS invoice → customer WhatsApp (restaurant/bar Create Invoice toolbar)
WHATSAPP_POS_INVOICE_TEMPLATE=hotel_bell_elite_invoice
WHATSAPP_POS_INVOICE_TEMPLATE_LANGUAGE=en
# Hotel checkout → guest feedback WhatsApp (Meta template hotel_feedback)
WHATSAPP_HOTEL_FEEDBACK_TEMPLATE=hotel_feedback
WHATSAPP_HOTEL_FEEDBACK_TEMPLATE_LANGUAGE=en
# Restaurant (Spices) Generate Invoice → guest feedback WhatsApp
WHATSAPP_SPICES_FEEDBACK_TEMPLATE=spices_feedback_template
WHATSAPP_SPICES_FEEDBACK_TEMPLATE_LANGUAGE=en
# Bar Generate Invoice → guest feedback WhatsApp (Meta template bar_feedback)
WHATSAPP_BAR_FEEDBACK_TEMPLATE=bar_feedback
WHATSAPP_BAR_FEEDBACK_TEMPLATE_LANGUAGE=en
# Purchase Order send to supplier — approved Meta template with Accept / Reject buttons
WHATSAPP_PO_TEMPLATE=purchase_order_hotel_bell_elite
WHATSAPP_PO_TEMPLATE_LANGUAGE=en
# One product per line: set to 10 after approving a template with {{3}}…{{12}}
# each on its own line (Meta forbids \n inside a single variable). 0 = legacy {{3}} blob.
WHATSAPP_PO_TEMPLATE_ITEM_SLOTS=0
# Safety: set to 1 to block all live Meta HTTP (messages + media upload)
# WHATSAPP_DRY_RUN=1
# Unit tests with Flask TESTING already block live sends unless this is 1
# WHATSAPP_ALLOW_IN_TESTS=0
# Host that receives Meta webhooks. Live Send for Approval from any other host
# is blocked so tokens are not written to a DB the webhook cannot see.
WHATSAPP_INDENT_PUBLIC_HOST=

# Hub mirroring permanently disabled (do not enable — caused production self-mirror lag).
# HUB_MIRROR_URL=
# HUB_MIRROR_TOKEN=

# Asia Tech Extranet (read-only reservations sync). Prefer these over Hotel Settings.
# Never commit real secrets. Base URL from vendor PDF.
ASIA_TECH_BASE_URL=https://provider.asiatech.in
ASIA_TECH_USERNAME=
ASIA_TECH_PASSWORD=
ASIA_TECH_HOTEL_ID=
# Channel Manager browser login (Bookings → Booking Reports → Check In).
# Required to sync stays by check-in date; JSON API alone only covers ~10 days of activity.
ASIA_TECH_CM_EMAIL=
ASIA_TECH_CM_PASSWORD=

# Daily sales WhatsApp report (Meta template hotel_sales_update — IMAGE header + 7 body params)
WHATSAPP_SALES_REPORT_TEMPLATE=hotel_sales_update
WHATSAPP_SALES_REPORT_TEMPLATE_LANGUAGE=en
WHATSAPP_SALES_REPORT_RECIPIENTS=+918940651222,+919150000267,+919531825665,+919933268361,+917900003192
# Room Transfer body {{8}}: keep 0 until the new Meta template is approved.
# After approval: set WHATSAPP_SALES_REPORT_TEMPLATE to the new name and INCLUDE_ROOM_TRANSFER=1
# (also auto-on when template name ends with _rt, e.g. hotel_sales_update_rt).
WHATSAPP_SALES_REPORT_INCLUDE_ROOM_TRANSFER=1

# Production Lightsail owns the nightly cron (deploy/lightsail/install_whatsapp_sales_cron.sh).
# On localhost/Mac keep this 0 so a local crontab cannot double-send to the same Meta WABA.
WHATSAPP_SALES_REPORT_SCHEDULE=0
WHATSAPP_SALES_REPORT_SCHEDULE_TIME=23:59
WHATSAPP_SALES_REPORT_SCHEDULE_TZ=Asia/Kolkata
