    function crEmpMatchScore(emp, query) {
      const name = String(emp.name || '').toLowerCase();
      const code = String(emp.emp_code || '').toLowerCase();
      const id = String(emp.id || '');
      if (!query) return -1;
      if (name === query || code === query || id === query) return 0;
      if (name.startsWith(query) || code.startsWith(query)) return 1;
      if (name.includes(query) || code.includes(query) || id.includes(query)) return 2;
      // token nearest match: any word starting with query
      const tokens = name.split(/\s+/);
      if (tokens.some((t) => t.startsWith(query))) return 1;
      if (tokens.some((t) => t.includes(query))) return 2;
      return -1;
    }

    function renderCrEmpSuggest(q) {
      const box = document.getElementById('pay-cr-emp-suggest');
      const input = document.getElementById('pay-cr-emp');
      if (!box) return;
      const query = String(q || '').trim().toLowerCase();
      if (!query) {
        closeCrEmpSuggest();
        return;
      }
      const ranked = (payState.picker || [])
        .map((e) => ({ emp: e, score: crEmpMatchScore(e, query) }))
        .filter((row) => row.score >= 0)
        .sort((a, b) => {
          if (a.score !== b.score) return a.score - b.score;
          return String(a.emp.name || '').localeCompare(String(b.emp.name || ''));
        })
        .slice(0, 8)
        .map((row) => row.emp);
      if (!ranked.length) {
        closeCrEmpSuggest();
        return;
      }
      box._matches = ranked;
      box.innerHTML = ranked.map((e, i) => {
        const meta = [e.emp_code || '', e.id ? ('ID ' + e.id) : ''].filter(Boolean).join(' · ');
        return (
          '<button type="button" role="option" data-cr-emp-idx="' + i + '">' +
            '<span class="pos-suggest-name">' + escapeHtml(e.name || 'Employee') + '</span>' +
            (meta ? ('<span class="meta">' + escapeHtml(meta) + '</span>') : '') +
          '</button>'
        );
      }).join('');
      box.classList.add('is-open');
      if (input) input.setAttribute('aria-expanded', 'true');
    }

