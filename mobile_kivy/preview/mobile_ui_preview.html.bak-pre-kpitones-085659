      const menu = document.getElementById('ir-pack-menu');
      if (!root || !menu || !product) return;
      const variants = Array.isArray(product.variants) ? product.variants : [];
      const basePrice = product.approximate_price == null ? '' : String(product.approximate_price);
      let html = '<button type="button" class="pos-listbox-option" role="option" data-value="" data-label="Base unit" data-qty="" data-price="' +
        escapeHtml(basePrice) + '" aria-selected="false">Base unit</button>';
      variants.forEach((v) => {
        const label = String((v && v.label) || '');
        if (!label) return;
        const qty = v.qty_in_base == null ? '' : String(v.qty_in_base);
        const price = v.approximate_price == null ? '' : String(v.approximate_price);
        html += '<button type="button" class="pos-listbox-option" role="option" data-value="' +
          escapeHtml(label) + '" data-label="' + escapeHtml(label) +
          '" data-qty="' + escapeHtml(qty) + '" data-price="' + escapeHtml(price) +
          '" aria-selected="false">' + escapeHtml(label) + '</button>';
      });
      menu.innerHTML = html;
      const defaultLabel = variants.length ? String(variants[0].label || 'Base unit') : 'Base unit';
      const defaultValue = variants.length ? String(variants[0].label || '') : '';
      setPosListboxValue(root, defaultValue, defaultLabel || 'Base unit');
