    (function bindEdgeBackGesture() {
      const root = document.getElementById('screen-workspace') || document.getElementById('phone');
      if (!root) return;
      const EDGE_PX = 28;
      const MIN_DX = 64;
      const MAX_DY = 56;
      let tracking = false;
      let startX = 0;
      let startY = 0;
      let fromLeft = false;

      function pointInRoot(clientX, clientY) {
        const rect = root.getBoundingClientRect();
        return {
          rect,
          x: clientX - rect.left,
          y: clientY - rect.top,
        };
      }

      function onStart(clientX, clientY) {
        const p = pointInRoot(clientX, clientY);
        fromLeft = p.x <= EDGE_PX;
        const fromRight = p.x >= p.rect.width - EDGE_PX;
        tracking = fromLeft || fromRight;
        startX = clientX;
        startY = clientY;
      }

      function onEnd(clientX, clientY) {
        if (!tracking) return;
        tracking = false;
        const dx = clientX - startX;
        const dy = clientY - startY;
        if (Math.abs(dx) < MIN_DX || Math.abs(dy) > MAX_DY) return;
        if (fromLeft && dx > MIN_DX) goBack();
        if (!fromLeft && dx < -MIN_DX) goBack();
      }

      root.addEventListener('touchstart', (event) => {
        if (!event.touches || event.touches.length !== 1) return;
        onStart(event.touches[0].clientX, event.touches[0].clientY);
      }, { passive: true });
      root.addEventListener('touchend', (event) => {
        if (!event.changedTouches || !event.changedTouches.length) return;
        onEnd(event.changedTouches[0].clientX, event.changedTouches[0].clientY);
      }, { passive: true });
      root.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        onStart(event.clientX, event.clientY);
      });
      root.addEventListener('pointerup', (event) => {
        onEnd(event.clientX, event.clientY);
      });
    })();
    if (window.__hbePendingScreen) {
      const pendingScreen = window.__hbePendingScreen;
      window.__hbePendingScreen = null;
      go(pendingScreen, { replace: true });
    }

