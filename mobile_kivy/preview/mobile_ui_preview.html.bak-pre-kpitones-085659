      });
      document.getElementById('pay-tip-entry-next')?.addEventListener('click', () => {
        if (!tipEntryState.calMonth) tipEntryState.calMonth = new Date();
        tipEntryState.calMonth = new Date(tipEntryState.calMonth.getFullYear(), tipEntryState.calMonth.getMonth() + 1, 1);
