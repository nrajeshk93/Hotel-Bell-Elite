    async function loadDashboard(opts) {
      const silent = opts && opts.silent;
      const token = ++mdLoadToken;
      setMdChrome();
      if (!silent) {
        const st = document.getElementById('md-status');
        if (st) {
          st.classList.remove('is-error');
          st.textContent = 'Loading ' + mdRangeLabel() + ' · ' + mdLocation + '…';
        }
      }
      try {
        let url = '/preview-api/dashboard?period=' + encodeURIComponent(mdPeriod)
          + '&location=' + encodeURIComponent(mdLocation);
        const dashDates = (typeof ledgerState !== 'undefined') ? ledgerState.dashboard : null;
        if (dashDates && dashDates.dateFrom && dashDates.dateTo) {
          url += '&date_from=' + encodeURIComponent(dashDates.dateFrom)
            + '&date_to=' + encodeURIComponent(dashDates.dateTo);
        }
        const res = await previewFetch(url, { cache: 'no-store' });
        const rawText = await res.text();
        if (token !== mdLoadToken) return;
        let data = null;
        try {
          data = JSON.parse(rawText);
        } catch (parseErr) {
          const looksHtml = /^\s*</.test(rawText || '');
          throw new Error(
            looksHtml
              ? 'Dashboard API returned HTML (restart mobile_kivy/preview/serve.py on port 8765)'
              : ((parseErr && parseErr.message) || 'Invalid JSON from dashboard API')
          );
        }
