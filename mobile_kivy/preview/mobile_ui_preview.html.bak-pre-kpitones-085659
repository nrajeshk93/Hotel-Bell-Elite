    function syncPosSettleVisibility() {
      const row = document.getElementById('pos-action-row');
      const settleBtn = document.getElementById('pos-btn-settle');
      const genBtn = document.getElementById('pos-btn-generate');
      const kotBtn = document.getElementById('pos-btn-footer-kot');
      const hasLines = !!(posState.lines && posState.lines.length);
      const pendingKot = posHasPendingKot();
      const showSettle = !!(
        posState.invoiceGenerated &&
        posState.invoiceId &&
        hasLines
      );
      const showGenerate = !!(
        !posState.invoiceGenerated &&
        hasLines &&
        !pendingKot
      );
      const showKot = !!(hasLines && pendingKot);
      if (settleBtn) settleBtn.hidden = !showSettle;
      if (genBtn) {
        genBtn.hidden = !showGenerate;
        genBtn.disabled = !showGenerate;
      }
      if (kotBtn) {
        kotBtn.hidden = !showKot;
        kotBtn.disabled = !showKot;
      }
      if (row) row.hidden = !showSettle;
