        if (!attDateState.calMonth) attDateState.calMonth = new Date();
        attDateState.calMonth = new Date(attDateState.calMonth.getFullYear(), attDateState.calMonth.getMonth() - 1, 1);
        renderAttCalendar();
      });
      document.getElementById('pay-att-cal-next')?.addEventListener('click', () => {
        if (!attDateState.calMonth) attDateState.calMonth = new Date();
        attDateState.calMonth = new Date(attDateState.calMonth.getFullYear(), attDateState.calMonth.getMonth() + 1, 1);
        renderAttCalendar();
      });
      document.getElementById('pay-att-cal-grid')?.addEventListener('click', (event) => {
