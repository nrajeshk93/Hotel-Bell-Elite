        if (title) title.textContent = emp.name || 'Employee';
        if (meta) {
          meta.textContent = [emp.emp_code || '', emp.location || '', (data.entry_count || 0) + ' entries']
            .filter(Boolean)
            .join(' · ');
        }
        if (kpis) {
          kpis.innerHTML = '<div class="pay-kpi"><b>' + payMoney(data.credit_balance) + '</b><span>Outstanding balance</span></div>';
        }
        const entries = data.entries || [];
        if (list) {
          list.innerHTML = entries.length
            ? ('<div class="cr-section-title">Transactions</div>' + entries.map(crTxnCard).join(''))
            : payEmpty('No credit transactions for this employee.');
        }
      } catch (_err) {
        if (meta) meta.textContent = 'Could not load history.';
        if (list) list.innerHTML = payEmpty('Could not load history.');
      }
    }

