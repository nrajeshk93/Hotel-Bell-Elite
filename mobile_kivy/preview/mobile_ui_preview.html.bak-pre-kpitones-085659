    async function loadApprovals(view, { soft, silent } = {}) {
      const nextView = view === 'approved' ? 'approved' : 'pending';
      setApprovalsChrome(nextView);
      const token = ++approvalsLoadToken;
      if (!soft && !silent) {
        setApprovalsStatus(nextView === 'approved' ? 'Loading approved…' : 'Loading pending…');
      }
      try {
        const data = await fetchApprovalsView(nextView);
        if (token !== approvalsLoadToken) return;
        const fp = approvalsDataFingerprint(nextView, data);
        if (silent && fp === approvalsFingerprint) {
          // Counts for the other tab may still drift — refresh quietly in background.
          const other = nextView === 'pending' ? 'approved' : 'pending';
          fetchApprovalsView(other).then((otherData) => {
            if (other === 'approved') approvalsCounts.approved = otherData.total;
            else approvalsCounts.pending = otherData.total;
            updateApprovalsTabCounts();
          }).catch(() => {});
          return;
        }
        const list = document.getElementById('approvals-list');
        const scrollParent = document.getElementById('main-content');
        const keepScroll = silent && scrollParent ? scrollParent.scrollTop : null;
        approvalsFingerprint = fp;
        renderApprovalsList(nextView, data.rows || [], data);
        if (keepScroll != null && scrollParent) scrollParent.scrollTop = keepScroll;
        const other = nextView === 'pending' ? 'approved' : 'pending';
        fetchApprovalsView(other).then((otherData) => {
          if (other === 'approved') approvalsCounts.approved = otherData.total;
          else approvalsCounts.pending = otherData.total;
          updateApprovalsTabCounts();
        }).catch(() => {});
      } catch (err) {
        if (token !== approvalsLoadToken) return;
        if (silent) return;
        setApprovalsStatus('Failed to load Approvals · ' + (err && err.message ? err.message : err));
        const list = document.getElementById('approvals-list');
        if (list) {
          list.innerHTML =
            '<div class="ap-card" id="de-nav-purchase-verification-preview">' +
              '<div class="ap-card-top"><div class="ap-card-code">Live data unavailable</div><div class="ap-card-amt">—</div></div>' +
              '<div class="ap-card-meta">Start preview with: python3 serve.py</div>' +
            '</div>';
        }
      }
    }

