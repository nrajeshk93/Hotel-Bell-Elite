      empSearch && empSearch.addEventListener('input', () => {
        clearTimeout(empTimer);
        empTimer = setTimeout(loadPayrollEmployees, 250);
      });
      document.getElementById('pay-emp-year')?.addEventListener('change', loadPayrollEmployees);
      document.getElementById('pay-emp-month')?.addEventListener('change', loadPayrollEmployees);
      document.getElementById('pay-emp-add-btn')?.addEventListener('click', addPayrollEmployee);

      document.getElementById('pay-emp-list')?.addEventListener('click', (event) => {
        const btn = event.target.closest('[data-pay-emp]');
        if (btn) loadPayrollEmployeeDetail(btn.getAttribute('data-pay-emp'));
      });
