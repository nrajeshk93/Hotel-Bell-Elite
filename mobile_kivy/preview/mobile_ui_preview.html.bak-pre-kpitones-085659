      document.getElementById('pay-tip-date-today')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        tipEntryState.draft = todayIso();
        const parts = tipEntryState.draft.split('-');
        tipEntryState.calMonth = new Date(Number(parts[0]), Number(parts[1]) - 1, 1);
        renderTipEntryCalendar();
