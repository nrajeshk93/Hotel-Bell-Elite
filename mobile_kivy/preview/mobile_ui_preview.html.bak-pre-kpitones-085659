    async function loadIndents(view, { soft, silent } = {}) {
      const nextView = view || indentView || 'pending';
      indentView = nextView;
      setIndentChrome(nextView);
      if (!silent) setIndentStatus(nextView === 'recent' ? 'Loading recent…' : 'Loading waiting…');
      try {
        const data = await fetchIndentView(nextView);
        renderIndentList(nextView, data.rows || [], data);
        const other = nextView === 'recent' ? 'pending' : 'recent';
        fetchIndentView(other).then((otherData) => {
          if (other === 'recent') indentRecentCount = otherData.total || 0;
          else indentPendingCount = otherData.total || 0;
          updateIndentTabCounts();
        }).catch(() => {});
      } catch (err) {
        if (!soft) {
          setIndentStatus('Failed to load · ' + (err && err.message ? err.message : err));
