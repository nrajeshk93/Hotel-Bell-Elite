    const PAY_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const payState = { emp: { year: 0, month: 0 }, picker: [] };

    function payMoney(v) {
      const n = Number(v || 0);
      return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
    }
    function payFillPeriodMenu(menuId, values, selected, labels) {
      const menu = document.getElementById(menuId);
      if (!menu) return;
      menu.innerHTML = values.map((val, i) => {
        const label = labels ? labels[i] : String(val);
        const sel = String(val) === String(selected);
        return '<button type="button" class="pos-listbox-option' + (sel ? ' is-selected' : '') + '" role="option" data-value="' + val + '" data-label="' + label + '" aria-selected="' + (sel ? 'true' : 'false') + '">' + label + '</button>';
      }).join('');
    }
    function paySetPeriod(prefix, year, month) {
      const yEl = document.getElementById(prefix + '-year');
      const mEl = document.getElementById(prefix + '-month');
      const yLab = document.getElementById(prefix + '-year-label');
      const mLab = document.getElementById(prefix + '-month-label');
      const y = Number(year) || new Date().getFullYear();
      const m = Math.min(12, Math.max(1, Number(month) || (new Date().getMonth() + 1)));
      if (yEl) yEl.value = String(y);
      if (mEl) mEl.value = String(m);
      if (yLab) yLab.textContent = String(y);
      if (mLab) mLab.textContent = PAY_MONTHS[m - 1] || 'Month';
      // Selected / current period first in each list.
      const years = [y, y - 1, y - 2, y + 1];
      const monthVals = [];
      const monthLabs = [];
      for (let i = 0; i < 12; i += 1) {
        const mv = ((m - 1 + i) % 12) + 1;
        monthVals.push(mv);
        monthLabs.push(PAY_MONTHS[mv - 1]);
      }
      payFillPeriodMenu(prefix + '-year-menu', years, y);
      payFillPeriodMenu(prefix + '-month-menu', monthVals, m, monthLabs);
    }
    function payQs(params) {
      const usp = new URLSearchParams();
      Object.keys(params || {}).forEach((k) => {
        const v = params[k];
        if (v !== undefined && v !== null && String(v) !== '') usp.set(k, String(v));
      });
      const s = usp.toString();
      return s ? ('?' + s) : '';
    }
    function payEmpty(msg) {
      return '<div class="pos-empty"><p>' + escapeHtml(String(msg || 'Nothing here.')) + '</p></div>';
    }


