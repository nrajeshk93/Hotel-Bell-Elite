    /* —— Indent Request: catalog + create via /stores/api/indent —— */
    const IR_UNITS = ['kg', 'gram', 'pcs', 'liter', 'mL', 'bunch', 'bottle', 'pack'];

    const irState = {
      outlet: 'restaurant',
      products: [],
      lines: [],
      picked: null,
      busy: false,
    };

    function irMoney(value) {
      const n = Number(value || 0);
      return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function irCsrfHeaders(extra) {
      const headers = Object.assign({ Accept: 'application/json' }, extra || {});
      const csrf = readCsrfCookie();
      if (csrf) {
        headers['X-CSRFToken'] = csrf;
        headers['X-CSRF-Token'] = csrf;
      }
      return headers;
    }

    function setIrStatus(text) {
      const el = document.getElementById('ir-status');
      if (el) el.textContent = text;
    }

    function irLineTotal(line) {
      return Math.round((Number(line.quantity || 0) * Number(line.approximate_price || 0)) * 100) / 100;
    }

    function syncIrNotesCount() {
      const notes = document.getElementById('ir-notes');
      const count = document.getElementById('ir-notes-count');
      if (!notes || !count) return;
      count.textContent = String((notes.value || '').length) + '/500';
    }

    function renderIrLines() {
      const wrap = document.getElementById('ir-lines');
      const empty = document.getElementById('ir-empty');
      const totalEl = document.getElementById('ir-total');
      if (!wrap) return;
      if (!irState.lines.length) {
        wrap.innerHTML = '';
        if (empty) empty.hidden = false;
        if (totalEl) totalEl.textContent = '₹0.00';
        return;
      }
      if (empty) empty.hidden = true;
      let running = 0;
      wrap.innerHTML = irState.lines.map((line, idx) => {
        const total = irLineTotal(line);
        running += total;
        const pack = line.pack_label || 'Base unit';
        return (
          '<div class="pos-line" data-idx="' + idx + '">' +
            '<button type="button" data-ir-remove="' + idx + '">' +
              escapeHtml(String(line.item_name || '')) +
              '<span class="ir-line-sub">' + escapeHtml(pack) + ' · ' + escapeHtml(String(line.unit || '')) + '</span>' +
            '</button>' +
            '<span>' + escapeHtml(String(line.quantity)) + '</span>' +
            '<span>' + irMoney(line.approximate_price).replace('₹', '') + '</span>' +
            '<span>' + irMoney(total).replace('₹', '') + '</span>' +
          '</div>'
        );
      }).join('');
      if (totalEl) totalEl.textContent = irMoney(running);
    }

    function renderIrSuggest(query) {
      const box = document.getElementById('ir-suggest');
      if (!box) return;
      const q = String(query || '').trim().toLowerCase();
      if (!q) {
        box.classList.remove('is-open');
        box.innerHTML = '';
        return;
      }
      const matches = irState.products.filter((p) => {
        const hay = ((p.name || '') + ' ' + (p.category_name || '')).toLowerCase();
        return hay.indexOf(q) >= 0;
      }).slice(0, 8);
      if (!matches.length) {
        box.classList.remove('is-open');
        box.innerHTML = '';
        return;
      }
      box._matches = matches;
      box.innerHTML = matches.map((p, i) => {
        const price = p.approximate_price_display || p.approximate_price || '';
        return (
          '<button type="button" data-ir-pick="' + i + '">' +
            escapeHtml(String(p.name || '')) +
            '<span class="meta">' +
              escapeHtml(String(p.category_name || '')) +
              (p.default_unit ? (' · ' + escapeHtml(String(p.default_unit))) : '') +
              (price !== '' && price != null ? (' · ' + escapeHtml(String(price))) : '') +
            '</span>' +
          '</button>'
        );
      }).join('');
      box.classList.add('is-open');
    }


