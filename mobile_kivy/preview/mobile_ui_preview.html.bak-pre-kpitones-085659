<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>HBE Mobile Preview (Kivy look-alike)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --accent: #1877F2;
      --theme: #1877F2;
      --accent-soft: #E8F1FE;
      --bg: #F7F8FA;
      --surface: #FFFFFF;
      --navy: #1A2744;
      --gold: #C4A46A;
      --text: #1A202C;
      --muted: #64748B;
      --nav-inactive: #4A5568;
      --login-gold: #C4A46A;
      --login-navy: #1A2744;
      --login-dark: #1A1F2E;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Manrope, "Segoe UI", system-ui, sans-serif;
      background: #111827;
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
      gap: 12px;
    }
    .banner {
      color: #e5e7eb;
      font-size: 13px;
      text-align: center;
      max-width: 420px;
      line-height: 1.4;
    }
    .banner strong { color: var(--login-gold); }
    body.is-bundled-app .banner { display: none; }
    body.is-bundled-app {
      padding: 0;
      margin: 0;
      gap: 0;
      background: var(--bg);
      min-height: 100dvh;
      height: 100dvh;
      overflow: hidden;
    }
    body.is-bundled-app .phone {
      width: 100%;
      max-width: none;
      height: 100dvh;
      min-height: 100dvh;
      border-radius: 0;
      border: none;
      box-shadow: none;
    }
    body.is-bundled-app .topbar {
      padding-top: max(env(safe-area-inset-top, 0px), 8px);
      min-height: calc(58px + env(safe-area-inset-top, 0px));
      height: auto;
    }
    body.is-bundled-app #screen-login {
      padding-top: max(env(safe-area-inset-top, 0px), 12px);
      padding-bottom: max(env(safe-area-inset-bottom, 0px), 12px);
    }
    body.is-bundled-app .screen {
      min-height: 0;
    }
    .phone {
      width: min(390px, 100%);
      height: min(780px, calc(100vh - 80px));
      background: var(--bg);
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,.45);
      border: 3px solid #374151;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .screen { display: none; flex: 1; flex-direction: column; min-height: 0; }
    .screen.is-active { display: flex; }
    #screen-workspace { position: relative; }

    /* —— Login (light, airy) —— */
    #screen-login {
      position: relative;
      align-items: stretch;
      justify-content: center;
      padding: 0;
      overflow: hidden;
      background: #F7F8FA;
    }
    .login-scroll {
      position: relative;
      z-index: 1;
      flex: 1;
      overflow-y: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: max(env(safe-area-inset-top, 0px), 48px) 28px max(env(safe-area-inset-bottom, 0px), 32px);
    }
    .login-panel {
      width: 100%;
      max-width: 320px;
      background: transparent;
      border-radius: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      box-shadow: none;
      position: relative;
      overflow: visible;
    }
    .login-mark {
      display: block;
      width: 56px;
      height: 56px;
      margin: 0 auto;
      object-fit: cover;
      border-radius: 50%;
    }
    .login-gold-rule {
      width: 32px;
      height: 2px;
      margin: 16px auto 0;
      background: #C4A46A;
      border-radius: 1px;
    }
    .brand {
      text-align: center;
      font-size: 28px;
      font-weight: 700;
      color: #1A202C;
      margin: 18px 0 0;
      font-family: Manrope, "Segoe UI", system-ui, sans-serif;
      letter-spacing: -0.03em;
      line-height: 1.15;
    }
    .login-sub {
      margin: 8px 0 0;
      font-size: 15px;
      font-weight: 500;
      color: #64748B;
      text-align: center;
    }
    .login-fields {
      margin-top: 36px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .login-field {
      position: relative;
      margin-top: 0;
    }
    .login-field label {
      display: block;
      position: static;
      top: auto;
      left: auto;
      padding: 0;
      background: transparent;
      font-size: 12px;
      font-weight: 500;
      color: #64748B;
      margin: 0 0 8px 4px;
      z-index: auto;
    }
    .login-field-inner {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 0 16px;
      min-height: 52px;
      height: 52px;
      background: #fff;
    }
    .login-field-inner:focus-within {
      border-color: #1877F2;
      box-shadow: 0 0 0 3px rgba(24, 119, 242, .12);
    }
    .login-field-inner svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      stroke: #94A3B8;
      fill: none;
      stroke-width: 1.7;
    }
    .login-field-inner input {
      flex: 1;
      border: 0;
      outline: none;
      font-size: 16px;
      padding: 0;
      margin: 0;
      background: transparent;
      font-family: inherit;
      color: #1A202C;
      min-width: 0;
    }
    .login-field-inner input::placeholder {
      color: #94A3B8;
      font-weight: 400;
    }
    .login-eye {
      border: 0;
      background: transparent;
      padding: 4px;
      cursor: pointer;
      color: #94A3B8;
      display: flex;
    }
    .btn-primary {
      margin-top: 24px;
      border: 0;
      border-radius: 999px;
      padding: 0;
      height: 52px;
      background: #1877F2;
      color: #fff;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      font-family: inherit;
      box-shadow: 0 8px 20px rgba(24, 119, 242, .18);
      position: relative;
      z-index: 1;
      width: 100%;
    }
    .btn-primary:disabled { opacity: 0.65; }
    .btn-ghost {
      border: 0;
      background: transparent;
      color: var(--accent);
      font-size: 13px;
      cursor: pointer;
      padding: 8px;
    }
    .login-staff {
      margin: 28px 0 0;
      text-align: center;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #94A3B8;
    }
    .login-captcha-block { margin-top: 16px; }
    .login-captcha-block[hidden] { display: none !important; }
    .login-error {
      margin: 12px 0 0;
      color: #B91C1C;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.35;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .login-error[hidden] { display: none !important; }
    .nav-item.is-access-hidden,
    .home-module.is-access-hidden,
    .home-module-grid.is-access-hidden,
    .nav-group.is-access-hidden,
    .home-module-group.is-access-hidden,
    .home-summary.is-access-hidden {
      display: none !important;
    }

    /* Workspace shell — light chrome (matches Home mock) */
    .topbar {
      height: 58px;
      background: #fff;
      color: var(--navy);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 8px 0 4px;
      flex-shrink: 0;
      position: relative;
      z-index: 2;
    }
    .topbar button {
      border: 0;
      background: transparent;
      color: var(--navy);
      font-size: 22px;
      width: 44px;
      height: 44px;
      cursor: pointer;
    }
    .topbar-notif {
      position: relative;
      display: grid;
      place-items: center;
    }
    .topbar-notif svg {
      width: 24px;
      height: 24px;
      stroke: var(--navy);
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .topbar-notif-dot {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #F97316;
      border: 1.5px solid #fff;
      display: none;
    }
    .topbar-notif.has-unread .topbar-notif-dot { display: block; }
    .topbar-ornament {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0;
      background: #fff;
      flex-shrink: 0;
      height: 14px;
      margin-top: -1px;
      position: relative;
      z-index: 1;
    }
    .topbar-ornament::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 1.5px;
      background: #1877F2;
    }
    .topbar-ornament svg {
      width: 22px;
      height: 22px;
      stroke: #1877F2;
      fill: #fff;
      stroke-width: 1.6;
      position: relative;
      z-index: 1;
      background: #fff;
      margin-top: 4px;
      border-radius: 50%;
    }
    .notif-panel {
      position: absolute;
      top: 68px;
      right: 10px;
      left: 10px;
      z-index: 40;
      background: linear-gradient(180deg, #FBFCFD 0%, #FFFFFF 28%);
      border-radius: 18px;
      box-shadow:
        0 18px 40px rgba(26, 39, 68, 0.16),
        0 2px 0 rgba(196, 164, 106, 0.35);
      border: 1px solid rgba(226, 232, 240, 0.95);
      overflow: hidden;
      max-height: min(380px, 58vh);
      display: flex;
      flex-direction: column;
      animation: notif-panel-in 0.22s ease-out;
    }
    @keyframes notif-panel-in {
      from { opacity: 0; transform: translateY(-8px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .notif-panel[hidden] { display: none !important; animation: none; }
    .notif-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px 12px;
      background: linear-gradient(180deg, #F4F7FB 0%, rgba(244, 247, 251, 0) 100%);
      border-bottom: 1px solid #EEF2F7;
      position: relative;
    }
    .notif-panel-head::after {
      content: "";
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 0;
      height: 2px;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--gold), transparent 70%);
      opacity: 0.85;
    }
    .notif-panel-head-copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .notif-panel-head strong {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--navy);
    }
    .notif-panel-sub {
      font-size: 11px;
      font-weight: 600;
      color: var(--muted);
    }
    .notif-count {
      flex: 0 0 auto;
      min-width: 28px;
      height: 28px;
      padding: 0 9px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-soft);
      color: var(--theme);
      font-size: 12px;
      font-weight: 800;
      border: 1px solid rgba(24, 119, 242, 0.12);
    }
    .notif-count[hidden] { display: none !important; }
    .notif-list {
      overflow: auto;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .notif-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      width: 100%;
      text-align: left;
      border: 1px solid transparent;
      background: #fff;
      border-radius: 14px;
      padding: 12px 12px 12px 10px;
      cursor: pointer;
      font: inherit;
      color: inherit;
      transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .notif-item:hover,
    .notif-item:focus-visible {
      background: #F8FAFC;
      border-color: #E2E8F0;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
      outline: none;
    }
    .notif-item:active {
      background: #F1F5F9;
    }
    .notif-item-icon {
      flex: 0 0 auto;
      width: 36px;
      height: 36px;
      border-radius: 11px;
      display: grid;
      place-items: center;
      background: var(--accent-soft);
      color: var(--theme);
    }
    .notif-item-icon svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .notif-item-icon.is-approval {
      background: #FEF3C7;
      color: #B45309;
    }
    .notif-item-icon.is-indent {
      background: #ECFDF5;
      color: #047857;
    }
    .notif-item-copy {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-top: 1px;
    }
    .notif-item-title {
      font-size: 13px;
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.01em;
      line-height: 1.25;
    }
    .notif-item-body {
      font-size: 12px;
      color: var(--muted);
      font-weight: 600;
      line-height: 1.4;
    }
    .notif-item-chev {
      flex: 0 0 auto;
      align-self: center;
      width: 16px;
      height: 16px;
      opacity: 0.35;
    }
    .notif-item-chev svg {
      width: 16px;
      height: 16px;
      stroke: var(--navy);
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .notif-empty {
      padding: 28px 16px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.45;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .notif-empty::before {
      content: "";
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background:
        radial-gradient(circle at 50% 42%, #fff 0 28%, transparent 29%),
        linear-gradient(145deg, var(--accent-soft), #EEF2FF);
      box-shadow: inset 0 0 0 1px rgba(24, 119, 242, 0.08);
      margin-bottom: 2px;
    }
    .topbar-brand {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 0;
    }
    .topbar-logo {
      width: 32px;
      height: 32px;
      object-fit: contain;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .topbar h1 {
      margin: 0;
      font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
      font-size: 20px;
      font-weight: 700;
      color: #1A2B4A;
      letter-spacing: 0.01em;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .body-row {
      flex: 1;
      display: flex;
      min-height: 0;
      position: relative;
      overflow: hidden;
    }
    .nav-scrim {
      position: absolute;
      inset: 0;
      z-index: 40;
      border: 0;
      margin: 0;
      padding: 0;
      background: rgba(26, 39, 68, 0.42);
      -webkit-backdrop-filter: blur(2px);
      backdrop-filter: blur(2px);
      cursor: pointer;
      opacity: 1;
      transition: opacity .2s ease;
    }
    .nav-scrim[hidden] {
      display: none !important;
    }
    .nav {
      --nav-ink: #1A2B4A;
      --nav-muted: #8FA3B8;
      --nav-active: #2B6DE8;
      --nav-active-bg: #EAF2FF;
      --nav-dot: #A9BBD0;
      --nav-gold: #C4A46A;
      --nav-card-border: #C9DBF0;
      --nav-card-bg: #F5F9FD;
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(300px, 86%);
      z-index: 41;
      background: #FBFCFD;
      border: 0;
      border-right: 1px solid #E6EEF7;
      border-radius: 0 22px 22px 0;
      overflow: hidden;
      padding: 0;
      box-shadow:
        0 22px 48px rgba(15, 28, 48, .18),
        0 3px 10px rgba(15, 28, 48, .06);
      transform: translateX(0);
      transition: transform .22s ease, box-shadow .22s ease;
      will-change: transform;
      display: flex;
      flex-direction: column;
    }
    .nav.collapsed {
      transform: translateX(-100%);
      box-shadow: none;
      pointer-events: none;
    }
    .nav-head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 18px 14px 12px 16px;
      flex-shrink: 0;
      background: #FBFCFD;
    }
    .nav-logo {
      width: 40px;
      height: 40px;
      object-fit: contain;
      flex-shrink: 0;
      border-radius: 50%;
    }
    .nav-brand {
      flex: 1;
      min-width: 0;
      font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
      font-weight: 700;
      font-size: 20px;
      line-height: 1.1;
      color: var(--nav-ink);
      letter-spacing: 0.01em;
      padding: 0;
      margin: 0;
    }
    .nav-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 0;
      background: #FFFFFF;
      color: var(--nav-ink);
      display: grid;
      place-items: center;
      cursor: pointer;
      flex-shrink: 0;
      padding: 0;
      box-shadow:
        0 3px 10px rgba(26, 43, 74, .1),
        0 1px 2px rgba(26, 43, 74, .06);
    }
    .nav-close svg {
      width: 14px;
      height: 14px;
      stroke: var(--nav-ink);
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }
    .nav-ornament {
      height: 18px;
      position: relative;
      flex-shrink: 0;
      margin: 0 18px 10px;
    }
    .nav-ornament::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 6px;
      height: 1.5px;
      background: linear-gradient(90deg, transparent 0%, var(--nav-gold) 8%, var(--nav-gold) 92%, transparent 100%);
    }
    .nav-ornament::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 3px;
      width: 8px;
      height: 8px;
      margin-left: -4px;
      border-right: 1.5px solid var(--nav-gold);
      border-bottom: 1.5px solid var(--nav-gold);
      transform: rotate(45deg);
      background: #FBFCFD;
      box-shadow: 0 0 0 3px #FBFCFD;
    }
    .nav-scroll {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 0 14px 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* legacy Edge */
    }
    .nav-scroll::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }
    .nav-menu-card {
      background: var(--nav-card-bg);
      border: 1px solid var(--nav-card-border);
      border-radius: 4px;
      padding: 8px 6px 10px;
      box-sizing: border-box;
    }
    .nav-group {
      font-size: 10px;
      letter-spacing: .1em;
      color: var(--nav-muted);
      padding: 14px 10px 6px;
      font-weight: 500;
      text-transform: uppercase;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 10px 11px 12px;
      border-radius: 10px;
      color: var(--nav-ink);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid transparent;
      margin-bottom: 1px;
      background: transparent;
      width: 100%;
      text-align: left;
      position: relative;
      font-family: inherit;
      letter-spacing: 0;
    }
    .nav-item .bullet {
      opacity: 1;
      color: var(--nav-dot);
      font-size: 8px;
      width: 12px;
      line-height: 1;
      flex-shrink: 0;
      transform: translateY(-0.5px);
      font-weight: 400;
    }
    .nav-item .nav-chev {
      margin-left: auto;
      width: 15px;
      height: 15px;
      stroke: #B0C2D6;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex-shrink: 0;
    }
    .nav-item.is-active {
      background: var(--nav-active-bg);
      color: var(--nav-active);
      border-color: transparent;
      box-shadow: none;
      font-weight: 600;
    }
    .nav-item.is-active .bullet { color: var(--nav-active); }
    .nav-item.is-active .nav-chev { stroke: #8FB4F0; }
    .nav-logout {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 6px 14px 16px;
      min-height: 48px;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1.5px solid #F0A8A8;
      background: #FDECEC;
      color: #E11D48;
      font: inherit;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      width: calc(100% - 28px);
      box-sizing: border-box;
      box-shadow: none;
    }
    .nav-logout svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
