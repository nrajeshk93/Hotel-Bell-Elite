  <script>
    const login = document.getElementById('screen-login');
    const workspace = document.getElementById('screen-workspace');
    const sidebar = document.getElementById('sidebar');
    const navScrim = document.getElementById('nav-scrim');
    const title = document.getElementById('top-title');
    const BRAND_TITLE = 'Hotel Bell Elite';
    const PREVIEW_AUTH_KEY = 'hbe_mobile_preview_auth';
    const PREVIEW_AUTH_DAYS = 30;
    const PREVIEW_AUTH_MS = PREVIEW_AUTH_DAYS * 24 * 60 * 60 * 1000;
    const SCREEN_ACCESS = {
      home: 'home',
      dashboard: 'main_dashboard',
      'indent-request': 'indent_request',
      'indent-approvals': 'indent_approvals',
      pos: 'pos',
      kot: 'kot',
      'pos-bar': 'pos_bar',
      'kot-bar': 'kot_bar',
      approvals: 'approvals',
      ledger: 'purchase_ledger',
      'cash-ledger': 'cash_ledger',
      'payroll-employee': 'payroll_employee',
      'payroll-attendance': 'payroll_attendance',
      'payroll-credit': 'payroll_credit',
      'payroll-tips': 'payroll_tips',
    };
    let previewAccess = null;
    const HBE_PRODUCTION = 'https://belleliteaccounts.com';
    const IS_BUNDLED_APP = location.protocol === 'file:'
      || String(location.href || '').startsWith('file://')
      || /HBEAndroidApp\//i.test(navigator.userAgent || '');
    const IS_PRODUCTION_APP = IS_BUNDLED_APP || /belleliteaccounts\.com/i.test(location.hostname || '');
    const USE_FLASK_SESSION = IS_PRODUCTION_APP && !IS_BUNDLED_APP;
    const FLASK_SESSION_TOKEN = 'cookie';
    const HBE_API_ROOT = (function () {
      if (IS_BUNDLED_APP) return HBE_PRODUCTION;
      const host = String(location.hostname || '').toLowerCase();
      if (host === 'belleliteaccounts.com' || host.endsWith('.belleliteaccounts.com')) return '';
      if (host === '127.0.0.1' || host === 'localhost') return '';
      return HBE_PRODUCTION;
    })();
    const DEFAULT_FLASK_BASE = USE_FLASK_SESSION ? HBE_PRODUCTION : (HBE_API_ROOT || 'http://127.0.0.1:8002');
    if (IS_BUNDLED_APP) {
      document.body.classList.add('is-bundled-app');
    }

    function readPreviewAuth() {
      try {
        const raw = localStorage.getItem(PREVIEW_AUTH_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        if (!data || !data.signedInAt) return null;
        if (!data.token) return null;
        const age = Date.now() - Number(data.signedInAt);
        if (!Number.isFinite(age) || age < 0 || age > PREVIEW_AUTH_MS) {
          localStorage.removeItem(PREVIEW_AUTH_KEY);
          return null;
        }
        return data;
      } catch (_err) {
        return null;
      }
    }

    function formatWelcomeName(raw) {
      const name = String(raw || '').trim().replace(/\s+/g, ' ');
      if (!name) return '';
      return name.replace(/\b\w/g, (ch) => ch.toUpperCase());
    }

    function writePreviewAuth(screen, opts) {
      try {
        const existing = readPreviewAuth();
        const nextName = opts && Object.prototype.hasOwnProperty.call(opts, 'displayName')
          ? String(opts.displayName || '').trim()
          : (existing && existing.displayName ? existing.displayName : '');
        const token = opts && opts.token != null
          ? String(opts.token || '')
          : (existing && existing.token ? existing.token : '');
        const access = opts && opts.access != null
          ? opts.access
          : (existing && existing.access ? existing.access : null);
        if (!token) return;
        localStorage.setItem(PREVIEW_AUTH_KEY, JSON.stringify({
          signedInAt: existing && existing.signedInAt ? existing.signedInAt : Date.now(),
          screen: screen || 'home',
          displayName: nextName,
          username: (opts && opts.username) || (existing && existing.username) || '',
          token: token,
          access: access,
        }));
        if (access) previewAccess = access;
      } catch (_err) {
        /* ignore quota / private mode */
      }
    }

    function previewAuthHeaders(extra) {
      const headers = Object.assign({}, extra || {});
      if (USE_FLASK_SESSION) return headers;
      const auth = readPreviewAuth();
      if (auth && auth.token && auth.token !== FLASK_SESSION_TOKEN) {
        headers['Authorization'] = 'Bearer ' + auth.token;
        headers['X-Preview-Token'] = auth.token;
      }
      return headers;
    }

    function previewFetch(url, options) {
      const opts = Object.assign({}, options || {});
      opts.headers = previewAuthHeaders(opts.headers);
      if (!opts.cache) opts.cache = 'no-store';
      if (USE_FLASK_SESSION) opts.credentials = 'include';
      const full = url.startsWith('http') ? url : (HBE_API_ROOT + url);
      return fetch(full, opts);
    }

    function readCsrfCookie() {
      const match = String(document.cookie || '').match(/(?:^|;\s*)hbe_csrf=([^;]+)/);
      return match ? decodeURIComponent(match[1]) : '';
    }

    async function flaskLogout() {
      const csrf = readCsrfCookie();
      const headers = {};
      if (csrf) {
        headers['X-CSRF-Token'] = csrf;
        headers['X-CSRFToken'] = csrf;
      }
      try {
        await fetch((HBE_API_ROOT || '') + '/logout', {
          method: 'POST',
          credentials: 'include',
          headers: headers,
        });
      } catch (_err) {
        /* ignore */
      }
    }

    function hasModuleAccess(key) {
      if (!key || key === 'home') return true;
      const access = previewAccess || (readPreviewAuth() && readPreviewAuth().access) || null;
      if (!access) return false;
      if (access.is_admin) return true;
      return !!access[key];
    }

    function applyPreviewAccess(access) {
      previewAccess = access || null;
      document.querySelectorAll('[data-access]').forEach((el) => {
        const key = el.getAttribute('data-access');
        el.classList.toggle('is-access-hidden', !hasModuleAccess(key));
      });
      document.querySelectorAll('[data-access-group]').forEach((el) => {
        const keys = String(el.getAttribute('data-access-group') || '')
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        const any = keys.some((k) => hasModuleAccess(k));
        el.classList.toggle('is-access-hidden', !any);
      });
    }

    function setLoginError(message) {
      const el = document.getElementById('login-error');
      if (!el) return;
      const text = String(message || '').trim();
      el.hidden = !text;
      el.textContent = text;
    }

    function updateHomeWelcome(nameHint) {
      const title = document.getElementById('home-welcome-title');
      if (!title) return;
      const auth = readPreviewAuth();
      const name = formatWelcomeName(
        nameHint != null && String(nameHint).trim()
          ? nameHint
          : (auth && auth.displayName)
      );
      title.textContent = name ? (name + '!') : 'Welcome!';
    }

    function clearPreviewAuth() {
      previewAccess = null;
      try {
        localStorage.removeItem(PREVIEW_AUTH_KEY);
      } catch (_err) {
        /* ignore */
      }
      applyPreviewAccess(null);
    }

    function scrollNavToActive() {
      const scroller = sidebar && sidebar.querySelector('.nav-scroll');
      if (!scroller) return;
      const active = Array.from(sidebar.querySelectorAll('.nav-item.is-active')).find((el) => {
        if (el.hidden) return false;
        const style = window.getComputedStyle(el);
        return style.display !== 'none' && style.visibility !== 'hidden' && el.offsetParent !== null;
      });
      if (!active) return;
      const scrollerRect = scroller.getBoundingClientRect();
      const activeRect = active.getBoundingClientRect();
      const offsetWithin = (activeRect.top - scrollerRect.top) + scroller.scrollTop;
      const target = offsetWithin - (scroller.clientHeight / 2) + (active.offsetHeight / 2);
      const max = Math.max(0, scroller.scrollHeight - scroller.clientHeight);
      const nextTop = Math.max(0, Math.min(max, target));
      if (typeof scroller.scrollTo === 'function') {
        scroller.scrollTo({ top: nextTop, behavior: 'smooth' });
      } else {
        scroller.scrollTop = nextTop;
      }
    }

    function setNavOpen(open) {
      sidebar.classList.toggle('collapsed', !open);
      sidebar.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (navScrim) navScrim.hidden = !open;
      document.getElementById('btn-menu').setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        // Wait for drawer open layout/paint, then center the active page link.
        requestAnimationFrame(() => {
          requestAnimationFrame(scrollNavToActive);
        });
        setTimeout(scrollNavToActive, 240);
      }
    }

    function showWorkspace(screen, displayName) {
      login.classList.remove('is-active');
      workspace.classList.add('is-active');
      setNavOpen(false);
      const next = screen || 'home';
      const name = formatWelcomeName(displayName);
      writePreviewAuth(next, name ? { displayName: name } : undefined);
      applyPreviewAccess(previewAccess || (readPreviewAuth() && readPreviewAuth().access));
      updateHomeWelcome(name);
      go(next, { replace: true });
      if (typeof startNotifPolling === 'function') startNotifPolling();
