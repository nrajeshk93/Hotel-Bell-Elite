      document.getElementById('pay-cr-list')?.addEventListener('click', (event) => {
        const card = event.target.closest('[data-cr-emp-id]');
        if (!card) return;
        const empId = card.getAttribute('data-cr-emp-id');
        if (!empId) return;
        setPayrollCreditDetailOpen(true, empId);
