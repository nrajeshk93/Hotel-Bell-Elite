      if (status) status.textContent = 'Loading employees…';
      try {
        const res = await previewFetch('/preview-api/payroll/employees' + payQs({ q: q, status: 'active', year: year, month: month }));
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (status) status.textContent = (data && data.error) || 'Could not load employees.';
          if (list) list.innerHTML = payEmpty('No employees.');
          return;
        }
        if (data.year && data.month) {
          paySetPeriod('pay-emp', data.year, data.month);
        }
        payState.emp.year = data.year;
        payState.emp.month = data.month;
        const st = data.payroll_state || {};
        const employees = data.employees || [];
        if (status) {
          status.textContent = employees.length + ' employees' +
            (st.label ? (' · ' + st.label) : '') +
            (st.locked ? ' · Locked' : '');
        }
        if (!list) return;
        if (!employees.length) {
          list.innerHTML = payEmpty('No employees match this search.');
          return;
        }
        list.innerHTML = employees.map(empCard).join('');
      } catch (_err) {
        if (status) status.textContent = 'Could not load employees.';
