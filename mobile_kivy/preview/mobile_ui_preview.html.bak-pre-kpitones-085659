    const tipEntryState = { date: '', draft: '', calMonth: null };

    function closeTipEntryPanel() {
      const chip = document.getElementById('pay-tip-entry-chip');
      const trigger = document.getElementById('pay-tip-entry-trigger');
      const panel = document.getElementById('pay-tip-entry-panel');
      if (chip) chip.classList.remove('is-open');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    }

    function syncTipEntryDisplay() {
      const hidden = document.getElementById('pay-tip-date');
      const iso = (hidden && hidden.value) || tipEntryState.date || '';
      tipEntryState.date = iso;
      const display = document.getElementById('pay-tip-entry-display');
      const chip = document.getElementById('pay-tip-entry-chip');
      if (display) {
        if (iso) {
          display.textContent = formatLedgerDisplayDate(iso);
          display.classList.remove('is-placeholder');
        } else {
          display.textContent = 'Select date…';
          display.classList.add('is-placeholder');
        }
      }
      if (chip) chip.classList.toggle('is-filtered', !!iso);
    }

    function renderTipEntryCalendar() {
      const grid = document.getElementById('pay-tip-entry-grid');
      const title = document.getElementById('pay-tip-entry-title');
      if (!grid || !title) return;
      if (!tipEntryState.calMonth) {
        const base = tipEntryState.draft || tipEntryState.date || todayIso();
        const d = new Date(base + 'T12:00:00');
        tipEntryState.calMonth = new Date(d.getFullYear(), d.getMonth(), 1);
      }
      const year = tipEntryState.calMonth.getFullYear();
      const month = tipEntryState.calMonth.getMonth();
      title.textContent = MD_MONTHS_FULL[month] + ' ' + year;
      const first = new Date(year, month, 1);
      const startPad = first.getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const prevDays = new Date(year, month, 0).getDate();
      const selected = tipEntryState.draft || tipEntryState.date || '';
      const head = document.getElementById('pay-tip-entry-headline');
      if (head) head.textContent = selected ? formatMdHeadlineDay(selected) : 'Select date';
      let out = '';
      for (let i = 0; i < 42; i++) {
        let dayNum, cellMonth = month, cellYear = year, muted = false;
        if (i < startPad) {
          dayNum = prevDays - startPad + i + 1;
          cellMonth = month - 1;
          if (cellMonth < 0) { cellMonth = 11; cellYear -= 1; }
          muted = true;
        } else if (i >= startPad + daysInMonth) {
          dayNum = i - startPad - daysInMonth + 1;
          cellMonth = month + 1;
          if (cellMonth > 11) { cellMonth = 0; cellYear += 1; }
          muted = true;
        } else {
          dayNum = i - startPad + 1;
        }
        const iso = cellYear + '-' + String(cellMonth + 1).padStart(2, '0') + '-' + String(dayNum).padStart(2, '0');
        const classes = ['ap-cal-day'];
        if (muted) classes.push('is-muted');
        if (selected && iso === selected) classes.push('is-selected', 'is-start', 'is-end');
        out += '<button type="button" class="' + classes.join(' ') + '" data-tip-entry-day="' + iso + '"><span class="ap-cal-day-num">' + dayNum + '</span></button>';
      }
      grid.innerHTML = out;
    }

    function openTipEntryPanel() {
      const chip = document.getElementById('pay-tip-entry-chip');
      const trigger = document.getElementById('pay-tip-entry-trigger');
      const panel = document.getElementById('pay-tip-entry-panel');
      if (!chip || !panel) return;
      const willOpen = !chip.classList.contains('is-open');
      if (typeof closeAllLedgerDatePanels === 'function') closeAllLedgerDatePanels();
      closeTipEntryPanel();
      if (!willOpen) return;
      chip.classList.add('is-open');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      tipEntryState.draft = tipEntryState.date || (document.getElementById('pay-tip-date') || {}).value || todayIso();
      const base = new Date(tipEntryState.draft + 'T12:00:00');
      tipEntryState.calMonth = new Date(base.getFullYear(), base.getMonth(), 1);
      renderTipEntryCalendar();
    }

    function commitTipEntryDate(iso) {
      tipEntryState.date = iso || todayIso();
      const hidden = document.getElementById('pay-tip-date');
      if (hidden) hidden.value = tipEntryState.date;
      syncTipEntryDisplay();
      closeTipEntryPanel();
    }

    function bindPayrollUi() {
