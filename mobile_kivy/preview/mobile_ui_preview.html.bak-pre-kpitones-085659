    function setPosListboxValue(root, value, labelText) {
      if (!root) return;
      const hidden = root.querySelector('input[type="hidden"]');
      const valueEl = root.querySelector('.pos-listbox-value');
      const menu = root.querySelector('.pos-listbox-menu');
      const next = value == null ? '' : String(value);
      if (hidden && hidden.value !== next) {
        hidden.value = next;
        hidden.dispatchEvent(new Event('change', { bubbles: true }));
      } else if (hidden) {
        hidden.value = next;
      }
      if (valueEl) {
        const label = (labelText != null && String(labelText)) || next || valueEl.getAttribute('data-placeholder') || 'Select…';
        valueEl.textContent = label;
        valueEl.classList.toggle('is-placeholder', !next);
      }
      if (menu) {
        menu.querySelectorAll('.pos-listbox-option').forEach((opt) => {
          const selected = String(opt.getAttribute('data-value') || '') === next;
          opt.classList.toggle('is-selected', selected);
          opt.setAttribute('aria-selected', selected ? 'true' : 'false');
        });
      }
    }

    function bindPosListboxes() {
      document.querySelectorAll('[data-pos-listbox]').forEach((root) => {
        if (root.dataset.bound === '1') return;
        root.dataset.bound = '1';
        const trigger = root.querySelector('.pos-listbox-trigger');
        const menu = root.querySelector('.pos-listbox-menu');
        const valueEl = root.querySelector('.pos-listbox-value');
        if (valueEl && !valueEl.getAttribute('data-placeholder')) {
          valueEl.setAttribute('data-placeholder', valueEl.textContent || 'Select…');
        }
        trigger?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const open = !root.classList.contains('is-open');
          closeAllPosListboxes(open ? root : null);
          root.classList.toggle('is-open', open);
          if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (menu) menu.hidden = !open;
          // Refresh occupancy when opening the table picker so status is live.
          if (open && root.id === 'pos-table-listbox') {
            loadPosTables({ force: true, quiet: true });
          }
        });
        menu?.addEventListener('click', (event) => {
          const opt = event.target && event.target.closest('.pos-listbox-option');
          if (!opt || !menu.contains(opt)) return;
          event.preventDefault();
          const value = opt.getAttribute('data-value') || '';
          const label = (opt.getAttribute('data-label') || opt.textContent || '').trim();
          setPosListboxValue(root, value, label);
          closeAllPosListboxes();
        });
      });
      if (document.documentElement.dataset.posListboxDocBound === '1') return;
      document.documentElement.dataset.posListboxDocBound = '1';
      document.addEventListener('click', (event) => {
        if (event.target && event.target.closest && event.target.closest('[data-pos-listbox]')) return;
        closeAllPosListboxes();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAllPosListboxes();
      });
    }

    async function loadPosTables(opts) {
      const force = opts && opts.force;
      const quiet = opts && opts.quiet;
      const hidden = document.getElementById('pos-table-select');
      const menu = document.getElementById('pos-table-menu');
      const root = document.getElementById('pos-table-listbox');
      if (!hidden || !menu || !root) return;
      if (posState.tablesLoaded && !force && menu.querySelectorAll('.pos-listbox-option[data-value]:not([data-value=""])').length) {
        return;
      }
      const prev = hidden.value;
      const prevStatus = quiet ? (document.getElementById('pos-status')?.textContent || '') : '';
      if (!quiet) setPosStatus('Loading tables…');
      try {
        const res = await previewFetch('/preview-api/pos/tables?outlet=' + encodeURIComponent(posState.outlet) + '&_=' + Date.now(), { cache: 'no-store' });
        const data = await res.json();
        const rows = (data && data.tables) || [];
        menu.innerHTML = '<button type="button" class="pos-listbox-option" role="option" data-value="" data-label="Select table…" aria-selected="false">Select table…</button>' +
          rows.map((row) => {
            const name = String(row.name || row.id || '');
            const status = row.status && row.status !== 'available' ? String(row.status) : '';
            return (
              '<button type="button" class="pos-listbox-option" role="option" data-value="' + escapeHtml(name) + '" data-label="' + escapeHtml(name) + '" aria-selected="false">' +
                escapeHtml(name) +
                (status ? '<span class="meta">' + escapeHtml(status) + '</span>' : '') +
              '</button>'
            );
          }).join('');
        posState.tablesLoaded = true;
        let next = '';
        if (prev && rows.some((row) => String(row.name || row.id || '') === prev)) {
          next = prev;
        }
        // Restore selection without re-firing change (invoice already loaded).
        if (hidden) hidden.value = next;
        const valueEl = root.querySelector('.pos-listbox-value');
        if (valueEl) {
          valueEl.textContent = next || 'Select table…';
          valueEl.classList.toggle('is-placeholder', !next);
        }
        menu.querySelectorAll('.pos-listbox-option').forEach((opt) => {
          const selected = String(opt.getAttribute('data-value') || '') === next;
          opt.classList.toggle('is-selected', selected);
          opt.setAttribute('aria-selected', selected ? 'true' : 'false');
        });
        if (quiet && prevStatus) {
          setPosStatus(prevStatus);
        } else {
          setPosStatus(next
            ? ('Table ' + next + ' · ' + rows.length + ' tables')
            : (rows.length ? 'Choose a table to start an order.' : 'No tables in floor layout.'));
        }
      } catch (err) {
        if (!quiet) setPosStatus(err && err.message ? err.message : 'Could not load tables');
      }
    }

    async function loadPosMenu(opts) {
      const force = opts && opts.force;
      if (posState.menuLoaded && !force && posState.menu.length) return posState.menu;
      try {
        const res = await previewFetch('/preview-api/pos/menu?outlet=' + encodeURIComponent(posState.outlet), { cache: 'no-store' });
        const data = await res.json();
        posState.menu = (data && data.items) || [];
        posState.menuLoaded = true;
        return posState.menu;
      } catch (_err) {
        posState.menu = [];
        return [];
      }
    }

    async function loadPosInvoiceForTable() {
      const select = document.getElementById('pos-table-select');
      const table = select && select.value;
      if (!table) {
        applyInvoiceToPos(null);
        setPosStatus('Choose a table to start an order.');
        return;
      }
      setPosStatus('Loading order for ' + table + '…');
      try {
        const res = await previewFetch(
          '/preview-api/pos/invoice-by-table?outlet=' + encodeURIComponent(posState.outlet) + '&table=' + encodeURIComponent(table),
          { cache: 'no-store' }
        );
        const data = await res.json();
        const invoice = data && data.invoice;
        applyInvoiceToPos(invoice || null);
        if (invoice && invoice.id) {
          setPosStatus('Loaded open invoice #' + invoice.id + ' · ' + table);
        } else {
          setPosStatus('New order · ' + table);
        }
      } catch (err) {
        applyInvoiceToPos(null);
        setPosStatus(err && err.message ? err.message : 'Could not load table order');
      }
    }

    function buildPosPayload(opts) {
      const kotSend = !!(opts && opts.kotSend);
      const customerBill = !!(opts && opts.customerBill);
      const select = document.getElementById('pos-table-select');
      const typeEl = document.getElementById('pos-order-type');
      const nameEl = document.getElementById('pos-customer-name');
      const mobileEl = document.getElementById('pos-customer-mobile');
      const notesEl = document.getElementById('pos-notes');
      const table = (select && select.value) || '';
      const orderType = (typeEl && typeEl.value) || 'dine_in';
      const totals = calcPosTotals();
      const orderNo = posState.orderNo || ('MOB-' + new Date().toISOString().slice(2, 10).replace(/-/g, '') + '-' + uid8().slice(0, 4).toUpperCase());
      const payload = {
        outlet: posState.outlet,
        orderNo,
        table,
        orderType,
        customerName: (nameEl && nameEl.value.trim()) || 'Guest',
        customerMobile: (mobileEl && mobileEl.value.replace(/\D/g, '').slice(-10)) || '',
        notes: (notesEl && notesEl.value.trim()) || '',
        kotSend,
        customerBill,
        discountType: 'pct',
        discountValue: Number(posState.discountPct) || 0,
        serviceType: 'pct',
        serviceValue: Number(posState.servicePct) || 0,
        tipAmount: Number(posState.tip) || 0,
        couponCode: posState.coupon || '',
        taxCgstPct: 2.5,
        taxUgstPct: 2.5,
        lines: posState.lines.map((line) => {
          const qty = Number(line.qty) || 0;
          let kotSentQty = Number(line.kotSentQty) || 0;
          // Match web POS: a KOT send persists lines with kotSentQty = qty.
          if (kotSend && qty > kotSentQty + 1e-9) {
            kotSentQty = qty;
          }
          return {
            uid: line.uid,
            menuId: line.menuId,
            name: line.name,
            category: line.category || '',
            variant: line.variant || '',
            rate: line.rate,
            qty,
            kotSentQty,
            notes: '',
          };
        }),
        totals: {
          subtotal: totals.subtotal,
          discount: totals.discount,
          discountType: 'pct',
          discountValue: Number(posState.discountPct) || 0,
          gst: totals.gst,
          cgst: totals.cgst,
          ugst: totals.sgst,
          service: totals.service,
          serviceType: 'pct',
          serviceValue: Number(posState.servicePct) || 0,
          tip: totals.tip,
          roundOff: totals.roundOff,
          total: totals.total,
        },
      };
      if (posState.invoiceId) payload.id = posState.invoiceId;
      return payload;
    }

    async function savePosInvoice(opts) {
      const select = document.getElementById('pos-table-select');
      if (!select || !select.value) {
        setPosStatus('Select a table first.');
        return null;
      }
      if (!posState.lines.length) {
        setPosStatus('Add menu items before saving.');
        return null;
      }
      const payload = buildPosPayload(opts);
      setPosStatus((opts && opts.kotSend) ? 'Sending KOT…' : 'Saving order…');
      const res = await previewFetch('/preview-api/pos/invoices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!data || !data.ok) {
        throw new Error((data && data.error) || 'Save failed');
      }
      const inv = data.invoice || {};
      posState.invoiceId = inv.id || posState.invoiceId;
      posState.orderNo = inv.order_no || inv.orderNo || payload.orderNo;
      if (opts && opts.customerBill) {
        posState.invoiceGenerated = true;
      } else if (inv.customer_bill_sent != null || inv.customerBillSent != null) {
        posState.invoiceGenerated = !!(inv.customer_bill_sent || inv.customerBillSent);
      }
      if (Array.isArray(inv.lines) && inv.lines.length) {
        applyInvoiceToPos(inv);
      } else {
        syncPosSettleVisibility();
      }
      return data;
    }

    async function loadPosScreen() {
      setPosChrome(true);
      await Promise.all([loadPosTables(), loadPosMenu()]);
      if (document.getElementById('pos-table-select')?.value) {
        await loadPosInvoiceForTable();
      } else {
        renderPosLines();
      }
    }

    bindPosListboxes();
    document.getElementById('pos-table-select')?.addEventListener('change', () => {
      loadPosInvoiceForTable();
    });
    document.getElementById('pos-btn-add-items')?.addEventListener('click', () => {
      const search = document.getElementById('pos-menu-search');
      if (search) {
        search.focus();
        search.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
    document.getElementById('pos-menu-search')?.addEventListener('input', async (event) => {
      const q = String(event.target.value || '').trim().toLowerCase();
      const suggest = document.getElementById('pos-menu-suggest');
      if (!suggest) return;
      await loadPosMenu();
      if (!q) {
        suggest.classList.remove('is-open');
        suggest.innerHTML = '';
        return;
      }
      const hits = posState.menu.filter((item) => {
        const name = String(item.name || '').toLowerCase();
        const code = String(item.code || item.barcode || '').toLowerCase();
        return name.indexOf(q) >= 0 || code.indexOf(q) >= 0;
      }).slice(0, 12);
      if (!hits.length) {
        suggest.classList.remove('is-open');
        suggest.innerHTML = '';
        return;
      }
      suggest.innerHTML = hits.map((item, idx) => (
        '<button type="button" role="option" data-pos-menu-idx="' + idx + '">' +
          '<strong>' + escapeHtml(item.name || '') + '</strong>' +
          '<span>' + moneyInr(item.rate || item.price || 0) + '</span>' +
        '</button>'
      )).join('');
      suggest._hits = hits;
      suggest.classList.add('is-open');
    });
    document.getElementById('pos-menu-suggest')?.addEventListener('click', (event) => {
      const btn = event.target && event.target.closest('[data-pos-menu-idx]');
      if (!btn) return;
      const suggest = document.getElementById('pos-menu-suggest');
      const idx = Number(btn.getAttribute('data-pos-menu-idx'));
      const item = suggest && suggest._hits && suggest._hits[idx];
      addPosMenuItem(item);
    });
    document.getElementById('pos-lines')?.addEventListener('click', (event) => {
      const btn = event.target && event.target.closest('[data-pos-remove]');
      if (!btn) return;
      const idx = Number(btn.getAttribute('data-pos-remove'));
      if (Number.isNaN(idx)) return;
      posState.lines.splice(idx, 1);
      renderPosLines();
    });
    document.getElementById('pos-notes')?.addEventListener('input', (event) => {
      const count = document.getElementById('pos-notes-count');
      if (count) count.textContent = String((event.target.value || '').length) + ' / 200';
    });
    document.querySelectorAll('[data-pos-quick]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.getAttribute('data-pos-quick');
        if (kind === 'discount') {
          const raw = window.prompt('Discount %', String(posState.discountPct || 0));
          if (raw == null) return;
          posState.discountPct = Math.max(0, Number(raw) || 0);
        } else if (kind === 'service') {
          const raw = window.prompt('Service charge %', String(posState.servicePct || 0));
          if (raw == null) return;
          posState.servicePct = Math.max(0, Number(raw) || 0);
        } else if (kind === 'tip') {
          const raw = window.prompt('Tip amount (₹)', String(posState.tip || 0));
          if (raw == null) return;
          posState.tip = Math.max(0, Number(raw) || 0);
        } else if (kind === 'coupon') {
          const raw = window.prompt('Coupon code', posState.coupon || '');
          if (raw == null) return;
          posState.coupon = String(raw || '').trim();
        } else {
          return;
        }
        renderPosLines();
        setPosStatus('Bill updated.');
      });
    });
    async function handlePosSendKot() {
      try {
        if (!posHasPendingKot()) {
          setPosStatus('Nothing new to send — kitchen is already up to date.');
          syncPosSettleVisibility();
          return;
        }
        const outletLabel = posOutletLabel();
        const data = await savePosInvoice({ kotSend: true });
        if (!data) return;
        // If save already marked kitchen-sent qty (web-compatible path), skip
        // the follow-up endpoint. Otherwise finish via dedicated send-kot.
        if (posState.invoiceId && posHasPendingKot()) {
          const kotRes = await previewFetch('/preview-api/pos/send-kot', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ invoice_id: posState.invoiceId, outlet: posState.outlet }),
          });
          const kotData = await kotRes.json();
          if (!kotData || !kotData.ok) {
            throw new Error((kotData && kotData.error) || 'KOT failed');
          }
          if (kotData.invoice) {
            applyInvoiceToPos(kotData.invoice);
          }
        } else if (Array.isArray((data.invoice || {}).lines)) {
          applyInvoiceToPos(data.invoice);
        } else {
          posState.lines.forEach((line) => {
            line.kotSentQty = Number(line.qty) || 0;
          });
          renderPosLines();
        }
        setPosStatus('KOT sent · ' + outletLabel + ' · invoice #' + (posState.invoiceId || '—'));
        await loadPosInvoiceForTable();
        syncPosSettleVisibility();
      } catch (err) {
        setPosStatus(err && err.message ? err.message : 'Send KOT failed');
        syncPosSettleVisibility();
      }
    }
    document.getElementById('pos-btn-footer-kot')?.addEventListener('click', handlePosSendKot);
    async function handlePosGenerateInvoice() {
      try {
        const nameEl = document.getElementById('pos-customer-name');
        if (!nameEl || !nameEl.value.trim()) {
          setPosStatus('Enter customer name before generating the invoice.');
          nameEl && nameEl.focus();
          return;
        }
        const pendingKot = posHasPendingKot();
        if (pendingKot) {
          setPosStatus('Send all items to the kitchen (KOT) before generating the invoice.');
          return;
        }
        const data = await savePosInvoice({ customerBill: true });
        if (!data) return;
        posState.invoiceGenerated = true;
        syncPosSettleVisibility();
        setPosStatus('Invoice generated · #' + (posState.invoiceId || '—') + ' — ready to settle');
        // Floor tile frees on Generate Invoice — refresh listbox meta immediately.
        await loadPosTables({ force: true, quiet: true });
        setPosStatus('Invoice generated · #' + (posState.invoiceId || '—') + ' — ready to settle');
      } catch (err) {
        setPosStatus(err && err.message ? err.message : 'Generate invoice failed');
      }
    }
    document.getElementById('pos-btn-generate')?.addEventListener('click', handlePosGenerateInvoice);
    document.getElementById('pos-btn-settle')?.addEventListener('click', async () => {
      try {
        if (!posState.invoiceGenerated || !posState.invoiceId) {
          setPosStatus('Generate the invoice before settle.');
          return;
        }
        const totals = calcPosTotals();
        setPosStatus('Settling…');
        const res = await previewFetch('/preview-api/pos/settle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            invoice_id: posState.invoiceId,
            outlet: posState.outlet,
            method: 'cash',
            payment_splits: [{ method: 'cash', amount: totals.total }],
          }),
        });
        const data = await res.json();
        if (!data || !data.ok) {
          throw new Error((data && data.error) || 'Settle failed');
        }
        posState.invoiceId = null;
        posState.orderNo = null;
        posState.invoiceGenerated = false;
        posState.lines = [];
        renderPosLines();
        setPosStatus('Settled · pick another table or start a new order.');
        await loadPosTables({ force: true });
      } catch (err) {
        setPosStatus(err && err.message ? err.message : 'Settle failed');
      }
    });

    /* —— Kitchen Order Tokens (KOT page) —— */
    const kotState = {
      outlet: 'restaurant',
      mode: 'resend',
      tables: [],
      expanded: {},
      draftQty: {},
      pendingChanges: null,
      busy: false,
      canEdit: true,
    };

    function setKotOutlet(outlet) {
      const next = outlet === 'bar' ? 'bar' : 'restaurant';
      if (kotState.outlet === next) return;
      kotState.outlet = next;
      kotState.tables = [];
      kotState.expanded = {};
      kotState.draftQty = {};
      kotState.pendingChanges = null;
    }

    function kotOutletLabel() {
      return kotState.outlet === 'bar' ? 'Bar' : 'Restaurant';
    }

    function setKotStatus(msg) {
      const el = document.getElementById('kot-status');
      if (el) el.textContent = msg || '';
    }

    function syncKotModeTabs() {
      document.querySelectorAll('[data-kot-mode]').forEach((btn) => {
        const active = btn.dataset.kotMode === kotState.mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function kotLineKey(tableIdx, lineId) {
      return String(tableIdx) + ':' + String(lineId);
    }

    function kotLineQty(tableIdx, line) {
      const key = kotLineKey(tableIdx, line.id);
      if (Object.prototype.hasOwnProperty.call(kotState.draftQty, key)) {
        return Number(kotState.draftQty[key]) || 0;
      }
      return Number(line.sent_qty != null ? line.sent_qty : line.qty) || 0;
    }

    function buildKotSlipText(token, lines) {
      const rows = lines && lines.length ? lines : (token.lines || []);
      const orderNo = token.kot_no || token.order_no || '—';
      const table = token.name || '—';
      const parts = [
        'KITCHEN ORDER TOKEN',
        'REPRINT / RESEND',
        'Order  ' + orderNo,
        'Table  ' + table,
        'Type   Dine In',
        'Items  ' + rows.length,
        '----------------------------',
      ];
      rows.forEach((line) => {
        const qty = Number(line.sent_qty != null ? line.sent_qty : line.qty) || 0;
        const name = line.name || 'Item';
        const variant = String(line.variant || '').trim();
        const notes = String(line.notes || '').trim();
        parts.push(qty + '  ' + (variant ? name + ' (' + variant + ')' : name));
        if (notes) parts.push('    note: ' + notes);
      });
      parts.push('----------------------------');
      parts.push('-- Resent for kitchen --');
      return parts.join('\n');
    }

    function buildKotSlipHtml(token, lines) {
      const rows = lines && lines.length ? lines : (token.lines || []);
      const orderNo = token.kot_no || token.order_no || '—';
      const table = token.name || '—';
      const bodyRows = rows.map((line) => {
        const qty = Number(line.sent_qty != null ? line.sent_qty : line.qty) || 0;
        const note = String(line.notes || '').trim();
        return (
          '<tr><td class="qty">' + qty + '</td><td class="name">' +
          escapeHtml(line.name || '') +
          (line.variant ? '<div class="variant">' + escapeHtml(line.variant) + '</div>' : '') +
          (note ? '<div class="note">' + escapeHtml(note) + '</div>' : '') +
          '</td></tr>'
        );
      }).join('');
      return (
        '<!DOCTYPE html><html><head><meta charset="utf-8"><title>KOT ' +
        escapeHtml(orderNo) +
        '</title><style>' +
        'body{font-family:"Courier New",monospace;padding:16px;color:#111;width:300px;margin:0 auto}' +
        'h1{font-size:16px;margin:0 0 4px;text-align:center;letter-spacing:.04em}' +
        '.banner{text-align:center;font-size:11px;font-weight:700;margin:0 0 8px;padding:4px;border:1px solid #333}' +
        '.meta{font-size:12px;margin-bottom:10px;border-bottom:1px dashed #333;padding-bottom:8px}' +
        '.meta div{display:flex;justify-content:space-between;margin:2px 0}' +
        'table{width:100%;border-collapse:collapse;font-size:13px}' +
        'td{padding:4px 0;border-bottom:1px dashed #ddd;vertical-align:top}' +
        'td.qty{width:34px;font-weight:700}' +
        '.variant{font-size:11px;color:#555}.note{font-size:11px;color:#333;font-style:italic}' +
        '.foot{margin-top:12px;text-align:center;font-size:11px;color:#555}' +
        '@media print{body{width:auto;margin:0}}' +
        '</style></head><body>' +
        '<h1>KITCHEN ORDER TOKEN</h1>' +
        '<div class="banner">REPRINT / RESEND</div>' +
        '<div class="meta">' +
        '<div><span>Order</span><span>' + escapeHtml(orderNo) + '</span></div>' +
        '<div><span>Table</span><span>' + escapeHtml(table) + '</span></div>' +
        '<div><span>Type</span><span>Dine In</span></div>' +
        '<div><span>Items</span><span>' + rows.length + '</span></div>' +
        '</div><table><tbody>' + bodyRows + '</tbody></table>' +
        '<div class="foot">-- Resent for kitchen --</div></body></html>'
      );
    }

    function openKotSlip(token, lines) {
      const text = buildKotSlipText(token, lines);
      const pre = document.getElementById('kot-slip-pre');
      if (pre) pre.textContent = text;
      const sheet = document.getElementById('kot-slip-sheet');
      if (sheet) {
        sheet.hidden = false;
        sheet.dataset.html = buildKotSlipHtml(token, lines);
      }
      if (typeof syncBackButton === 'function') syncBackButton();
    }

    function closeKotSlip() {
      const sheet = document.getElementById('kot-slip-sheet');
      if (sheet) {
        sheet.hidden = true;
        delete sheet.dataset.html;
      }
      if (typeof syncBackButton === 'function') syncBackButton();
    }

    function openKotReason(changes) {
      kotState.pendingChanges = changes;
      const input = document.getElementById('kot-reason-input');
      if (input) input.value = '';
      const sheet = document.getElementById('kot-reason-sheet');
      if (sheet) sheet.hidden = false;
    }

    function closeKotReason() {
      kotState.pendingChanges = null;
      const sheet = document.getElementById('kot-reason-sheet');
      if (sheet) sheet.hidden = true;
      if (typeof syncBackButton === 'function') syncBackButton();
    }

    function renderKotList() {
      const list = document.getElementById('kot-list');
      const empty = document.getElementById('kot-empty');
      if (!list || !empty) return;
      const tables = kotState.tables || [];
      const editMode = kotState.mode === 'edit';
      syncKotModeTabs();

      if (!tables.length) {
        list.innerHTML = '';
        empty.hidden = false;
        return;
      }
      empty.hidden = true;

      list.innerHTML = tables.map((token, idx) => {
        const open = !!kotState.expanded[idx];
        const lines = Array.isArray(token.lines) ? token.lines : [];
        const kotNo = token.kot_no || token.order_no || '—';
        const items = Number(token.sent_items) || lines.length || 0;
        const sentAt = token.sent_at ? String(token.sent_at) : '';
        const lineHtml = lines.map((line) => {
          const qty = kotLineQty(idx, line);
          const orig = Number(line.sent_qty != null ? line.sent_qty : line.qty) || 0;
          const label = (line.name || 'Item') + (line.variant ? ' (' + line.variant + ')' : '');
          const notes = String(line.notes || '').trim();
          if (editMode) {
            return (
              '<div class="kot-line" data-kot-table="' + idx + '" data-kot-line-id="' + escapeHtml(line.id) + '" data-kot-orig="' + orig + '">' +
              '<div class="kot-line-name">' + escapeHtml(label) +
              (notes ? '<small>' + escapeHtml(notes) + '</small>' : '') +
              '</div>' +
              '<span class="kot-qty-stepper">' +
              '<button type="button" class="kot-qty-btn" data-kot-qty-dec' + (qty <= 0 ? ' disabled' : '') + '>−</button>' +
              '<span class="kot-qty-val">' + qty + '</span>' +
              '<button type="button" class="kot-qty-btn" data-kot-qty-inc' + (qty >= 999 ? ' disabled' : '') + '>+</button>' +
              '</span></div>'
            );
          }
          return (
            '<label class="kot-line">' +
            '<input class="kot-line-check" type="checkbox" checked data-kot-table="' + idx + '" data-kot-line-id="' + escapeHtml(line.id) + '" />' +
            '<div class="kot-line-name">' + escapeHtml(label) + ' × ' + orig +
            (notes ? '<small>' + escapeHtml(notes) + '</small>' : '') +
            '</div></label>'
          );
        }).join('');

        const actions = editMode
          ? '<div class="kot-card-actions"><button type="button" class="kot-btn kot-btn--primary" data-kot-save="' + idx + '">Save changes</button></div>'
          : (
            '<div class="kot-card-actions">' +
            '<button type="button" class="kot-btn kot-btn--primary" data-kot-resend="' + idx + '">Resend selected</button>' +
            '<button type="button" class="kot-btn kot-btn--ghost" data-kot-resend-all="' + idx + '">Resend all</button>' +
            '</div>'
          );

        return (
          '<article class="kot-card' + (open ? ' is-open' : '') + '" data-kot-card="' + idx + '">' +
          '<button type="button" class="kot-card-head" data-kot-toggle="' + idx + '">' +
          '<div><strong>' + escapeHtml(token.name || 'Table') + '</strong>' +
          '<div class="kot-card-meta">' + escapeHtml(kotNo) + ' · ' + items + ' item' + (items === 1 ? '' : 's') +
          (sentAt ? ' · ' + escapeHtml(sentAt) : '') + '</div></div>' +
          '<svg class="kot-card-chev" viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>' +
          '</button>' +
          '<div class="kot-card-body"' + (open ? '' : ' hidden') + '>' + lineHtml + actions + '</div>' +
          '</article>'
        );
      }).join('');
    }

    async function loadKotTokens(opts) {
      const force = !!(opts && opts.force);
      if (kotState.busy && !force) return;
      kotState.busy = true;
      setKotStatus('Loading kitchen tokens…');
      try {
        const res = await previewFetch(
          '/preview-api/pos/kot-tokens?outlet=' + encodeURIComponent(kotState.outlet),
          { cache: 'no-store' }
        );
        const data = await res.json();
        if (!res.ok || (data && data.ok === false)) {
          throw new Error((data && data.error) || 'Failed to load KOT tokens');
        }
        kotState.tables = Array.isArray(data.tables) ? data.tables : [];
        kotState.draftQty = {};
        const count = kotState.tables.length;
        setKotStatus(
          count === 0
            ? ('No active ' + kotOutletLabel() + ' KOTs')
            : ('Showing ' + count + ' ' + kotOutletLabel() + ' token' + (count === 1 ? '' : 's'))
        );
        renderKotList();
      } catch (err) {
        kotState.tables = [];
        renderKotList();
        setKotStatus(err && err.message ? err.message : 'KOT load failed');
      } finally {
        kotState.busy = false;
      }
    }

    function collectKotEdits(tableIdx) {
      const token = kotState.tables[tableIdx];
      if (!token) return { changes: [], hasReduce: false };
      const invoiceId = Number(token.invoice_id || 0);
      const changes = [];
      let hasReduce = false;
      (token.lines || []).forEach((line) => {
        const orig = Number(line.sent_qty != null ? line.sent_qty : line.qty) || 0;
        const next = kotLineQty(tableIdx, line);
        if (Math.abs(next - orig) < 1e-9) return;
        if (next < orig) hasReduce = true;
        changes.push({
          invoice_id: invoiceId,
          line_id: Number(line.id),
          sent_qty: next,
        });
      });
      return { changes, hasReduce };
    }

    async function submitKotEdits(changes, reason) {
      setKotStatus('Saving KOT edits…');
      try {
        const res = await previewFetch('/preview-api/pos/kot-tokens/reduce', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            outlet: kotState.outlet,
            changes,
            reason: reason || '',
          }),
        });
        const data = await res.json();
        if (!res.ok || (data && data.ok === false)) {
          throw new Error((data && data.error) || 'KOT edit failed');
        }
        closeKotReason();
        setKotStatus('KOT updated');
        await loadKotTokens({ force: true });
      } catch (err) {
        setKotStatus(err && err.message ? err.message : 'KOT edit failed');
      }
    }

    document.getElementById('kot-btn-refresh')?.addEventListener('click', () => loadKotTokens({ force: true }));
    document.querySelectorAll('[data-kot-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        kotState.mode = btn.dataset.kotMode === 'edit' ? 'edit' : 'resend';
        renderKotList();
      });
    });
    document.getElementById('kot-list')?.addEventListener('click', (ev) => {
      const toggle = ev.target.closest('[data-kot-toggle]');
      if (toggle) {
        const idx = Number(toggle.getAttribute('data-kot-toggle'));
        kotState.expanded[idx] = !kotState.expanded[idx];
        renderKotList();
        return;
      }
      const dec = ev.target.closest('[data-kot-qty-dec]');
      const inc = ev.target.closest('[data-kot-qty-inc]');
      if (dec || inc) {
        const row = ev.target.closest('[data-kot-table][data-kot-line-id]');
        if (!row) return;
        const tableIdx = Number(row.getAttribute('data-kot-table'));
        const lineId = row.getAttribute('data-kot-line-id');
        const token = kotState.tables[tableIdx];
        const line = (token && token.lines || []).find((l) => String(l.id) === String(lineId));
        if (!line) return;
        const key = kotLineKey(tableIdx, lineId);
        let qty = kotLineQty(tableIdx, line);
        qty = dec ? Math.max(0, qty - 1) : Math.min(999, qty + 1);
        kotState.draftQty[key] = qty;
        renderKotList();
        return;
      }
      const saveBtn = ev.target.closest('[data-kot-save]');
      if (saveBtn) {
        const idx = Number(saveBtn.getAttribute('data-kot-save'));
        const result = collectKotEdits(idx);
        if (!result.changes.length) {
          setKotStatus('No quantity changes to save');
          return;
        }
        if (result.hasReduce) {
          openKotReason(result.changes);
        } else {
          submitKotEdits(result.changes, '');
        }
        return;
      }
      const resendAll = ev.target.closest('[data-kot-resend-all]');
      const resendSel = ev.target.closest('[data-kot-resend]');
      if (resendAll || resendSel) {
        const idx = Number((resendAll || resendSel).getAttribute(resendAll ? 'data-kot-resend-all' : 'data-kot-resend'));
        const token = kotState.tables[idx];
        if (!token) return;
        let lines = token.lines || [];
        if (resendSel) {
          const checked = Array.from(
            document.querySelectorAll('#kot-list input.kot-line-check[data-kot-table="' + idx + '"]:checked')
          ).map((el) => String(el.getAttribute('data-kot-line-id')));
          lines = lines.filter((line) => checked.includes(String(line.id)));
        }
        if (!lines.length) {
          setKotStatus('Select at least one item to resend');
          return;
        }
        openKotSlip(token, lines);
      }
    });
    document.getElementById('kot-reason-cancel')?.addEventListener('click', closeKotReason);
    document.getElementById('kot-reason-save')?.addEventListener('click', () => {
      const reason = String(document.getElementById('kot-reason-input')?.value || '').trim();
      if (!reason) {
        setKotStatus('Reason is required for reductions');
        return;
      }
      const changes = kotState.pendingChanges || [];
      if (!changes.length) {
        closeKotReason();
        return;
      }
      submitKotEdits(changes, reason);
    });
    document.getElementById('kot-slip-close')?.addEventListener('click', closeKotSlip);
    document.getElementById('kot-slip-print')?.addEventListener('click', () => {
      const sheet = document.getElementById('kot-slip-sheet');
      const html = sheet && sheet.dataset.html;
      if (!html) return;
      const win = window.open('', '_blank', 'noopener,noreferrer,width=420,height=640');
      if (!win) {
        setKotStatus('Pop-up blocked — allow pop-ups to print');
        return;
      }
      win.document.write(html);
      win.document.close();
      try { win.focus(); win.print(); } catch (_) {}
    });
    document.getElementById('kot-slip-sheet')?.addEventListener('click', (ev) => {
      if (ev.target.id === 'kot-slip-sheet') closeKotSlip();
    });
    document.getElementById('kot-reason-sheet')?.addEventListener('click', (ev) => {
      if (ev.target.id === 'kot-reason-sheet') closeKotReason();
    });

    /* —— Purchase / Expenses / Ledger (Approvals-style, web ledger totals) —— */
    const ledgerState = {
      ledger: { tab: 'all', rows: [], totals: null, dateFrom: '', dateTo: '', cleared: false, calMonth: null, pickStart: null, draftFrom: '', draftTo: '' },
      'cash-ledger': { location: 'All', rows: [], totals: null, dateFrom: '', dateTo: '', cleared: false, calMonth: null, pickStart: null, draftFrom: '', draftTo: '' },
      'pay-tip': { dateFrom: '', dateTo: '', cleared: false, calMonth: null, pickStart: null, draftFrom: '', draftTo: '' },
      approvals: { dateFrom: '', dateTo: '', cleared: false, calMonth: null, pickStart: null, draftFrom: '', draftTo: '' },
      dashboard: { location: 'All', dateFrom: '', dateTo: '', cleared: false, calMonth: null, pickStart: null, draftFrom: '', draftTo: '' },
    };
    function mdIsoDate(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function mdDefaultRange() {
      const to = new Date();
      const from = new Date(to.getFullYear(), to.getMonth(), to.getDate() - 29);
      return { from: mdIsoDate(from), to: mdIsoDate(to) };
    }
    function seedDashboardDates() {
      const state = ledgerState.dashboard;
      if (!state) return;
      const d = mdDefaultRange();
      state.dateFrom = d.from;
      state.dateTo = d.to;
      state.cleared = false;
      state.pickStart = null;
      state.draftFrom = d.from;
      state.draftTo = d.to;
      mdPeriod = '30d';
      if (typeof syncLedgerDateInputs === 'function') syncLedgerDateInputs('dashboard');
    }
    const LEDGER_MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const MD_MONTHS_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const MD_DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

    function ledgerDom(screen) {
      if (screen === 'pay-tip') {
        return {
          chip: document.getElementById('pay-tip-range-chip'),
          trigger: document.getElementById('pay-tip-range-trigger'),
          panel: document.getElementById('pay-tip-range-panel'),
          grid: document.getElementById('pay-tip-cal-grid'),
          title: document.getElementById('pay-tip-cal-title'),
          headline: document.getElementById('pay-tip-date-headline'),
          from: document.getElementById('pay-tip-from'),
          to: document.getElementById('pay-tip-to'),
          display: document.getElementById('pay-tip-range-display'),
        };
      }
      if (screen === 'approvals') {
        return {
          chip: document.getElementById('approvals-date-chip'),
          trigger: document.getElementById('btn-approvals-filter'),
          panel: document.getElementById('approvals-date-panel'),
          grid: document.getElementById('approvals-cal-grid'),
          title: document.getElementById('approvals-cal-title'),
          headline: document.getElementById('approvals-date-headline'),
          from: null,
          to: null,
          display: document.getElementById('approvals-date-display'),
          range: document.getElementById('approvals-range'),
        };
      }
      return {
        chip: document.getElementById(screen + '-date-chip'),
        trigger: document.getElementById(screen + '-date-trigger'),
        panel: document.getElementById(screen + '-date-panel'),
        grid: document.getElementById(screen + '-cal-grid'),
        title: document.getElementById(screen + '-cal-title'),
        headline: document.getElementById(screen + '-date-headline'),
        from: document.getElementById(screen + '-date-from'),
        to: document.getElementById(screen + '-date-to'),
        display: document.getElementById(screen + '-date-display'),
      };
    }

    function parseIsoDate(iso) {
      const parts = String(iso || '').slice(0, 10).split('-');
      if (parts.length !== 3) return null;
      const y = Number(parts[0]), m = Number(parts[1]), d = Number(parts[2]);
      if (!y || !m || !d) return null;
      return { y: y, m: m, d: d, date: new Date(y, m - 1, d) };
    }

    function formatMdHeadlineDay(iso) {
      const p = parseIsoDate(iso);
      if (!p) return 'Select date';
      return MD_DOW[p.date.getDay()] + ', ' + LEDGER_MONTHS[p.m - 1] + ' ' + p.d;
    }

    function formatMdRangeHeadline(from, to) {
      if (from && to && from !== to) {
        const a = parseIsoDate(from);
        const b = parseIsoDate(to);
        if (!a || !b) return formatMdHeadlineDay(from || to);
        return LEDGER_MONTHS[a.m - 1] + ' ' + a.d + ' – ' + LEDGER_MONTHS[b.m - 1] + ' ' + b.d;
      }
      return formatMdHeadlineDay(from || to || '');
    }

    function updateMdRangeHeadline(screen) {
      const state = ledgerState[screen];
      const el = ledgerDom(screen).headline;
      if (!state || !el) return;
      const from = state.pickStart || state.draftFrom || '';
      const to = state.pickStart ? '' : (state.draftTo || '');
      el.textContent = (from || to) ? formatMdRangeHeadline(from, to) : 'Select date';
    }

    function indianFyStartIso(today) {
      const d = today || new Date();
      const year = d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1;
      return year + '-04-01';
    }

    function todayIso() {
      const d = new Date();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return d.getFullYear() + '-' + m + '-' + day;
    }

    function formatLedgerDisplayDate(iso) {
      if (!iso) return '';
      const parts = String(iso).slice(0, 10).split('-');
      if (parts.length !== 3) return String(iso);
      const y = Number(parts[0]);
      const m = Number(parts[1]);
      const d = Number(parts[2]);
      if (!y || !m || !d) return String(iso);
      return String(d).padStart(2, '0') + ' ' + LEDGER_MONTHS[m - 1] + ' ' + y;
    }

    function syncLedgerDateInputs(screen) {
      const state = ledgerState[screen];
      if (!state) return;
      const dom = ledgerDom(screen);
      if (dom.from) dom.from.value = state.dateFrom || '';
      if (dom.to) dom.to.value = state.dateTo || '';
      if (dom.range) {
        dom.range.textContent = (state.dateFrom || state.dateTo)
          ? ((state.dateFrom || '…') + ' – ' + (state.dateTo || '…'))
          : '';
      }
      if (dom.display) {
        if (state.dateFrom || state.dateTo) {
          if (state.dateFrom && state.dateTo && state.dateFrom !== state.dateTo) {
            dom.display.textContent = formatLedgerDisplayDate(state.dateFrom) +
              ' – ' + formatLedgerDisplayDate(state.dateTo);
          } else {
            dom.display.textContent = formatLedgerDisplayDate(state.dateFrom || state.dateTo);
          }
          dom.display.classList.remove('is-placeholder');
        } else {
          dom.display.textContent = 'Select date…';
          dom.display.classList.add('is-placeholder');
        }
      }
      if (dom.chip) dom.chip.classList.toggle('is-filtered', !!(state.dateFrom || state.dateTo));
    }

    function ensureLedgerDefaultDates(screen) {
      const state = ledgerState[screen];
      if (!state || state.cleared) return;
      if (screen === 'dashboard') {
        if (!state.dateFrom && !state.dateTo) seedDashboardDates();
        else syncLedgerDateInputs(screen);
        return;
      }
      if (!state.dateFrom && !state.dateTo) {
        state.dateFrom = indianFyStartIso();
        state.dateTo = todayIso();
      }
      syncLedgerDateInputs(screen);
    }
    seedDashboardDates();

    function closeAllLedgerDatePanels(exceptScreen) {
      if (typeof closeAttDatePanel === 'function') closeAttDatePanel();
      if (typeof closeCrDatePanels === 'function') closeCrDatePanels();
      if (typeof closeTipEntryPanel === 'function') closeTipEntryPanel();
      ['ledger', 'cash-ledger', 'pay-tip', 'approvals'].forEach((screen) => {
        if (exceptScreen && screen === exceptScreen) return;
        const dom = ledgerDom(screen);
        if (dom.chip) dom.chip.classList.remove('is-open');
        if (dom.trigger) dom.trigger.setAttribute('aria-expanded', 'false');
        if (dom.panel) dom.panel.hidden = true;
      });
    }

    function openLedgerDatePanel(screen) {
      const state = ledgerState[screen];
      if (!state) return;
      closeAllLedgerDatePanels(screen);
      const dom = ledgerDom(screen);
      if (!dom.chip || !dom.panel) return;
      const open = !dom.chip.classList.contains('is-open');
      dom.chip.classList.toggle('is-open', open);
      if (dom.trigger) dom.trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      dom.panel.hidden = !open;
      if (open) {
        state.pickStart = null;
        state.draftFrom = state.dateFrom || '';
        state.draftTo = state.dateTo || '';
        const anchor = state.dateTo || state.dateFrom || todayIso();
        const parts = String(anchor).split('-');
        state.calMonth = new Date(Number(parts[0]), Number(parts[1]) - 1, 1);
        updateMdRangeHeadline(screen);
        renderLedgerCalendar(screen);
      }
    }

    function renderLedgerCalendar(screen) {
      const state = ledgerState[screen];
      const dom = ledgerDom(screen);
      const grid = dom.grid;
      const title = dom.title;
      if (!state || !grid || !title) return;
      if (!state.calMonth) state.calMonth = new Date();
      const year = state.calMonth.getFullYear();
      const month = state.calMonth.getMonth();
      title.textContent = MD_MONTHS_FULL[month] + ' ' + year;
      const first = new Date(year, month, 1);
      const startPad = first.getDay(); // Sunday-first
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const prevDays = new Date(year, month, 0).getDate();
      let from;
      let to;
      if (state.pickStart) {
        from = state.pickStart;
        to = '';
      } else if (state.draftFrom || state.draftTo) {
        from = state.draftFrom || '';
        to = state.draftTo || '';
      } else {
        from = state.dateFrom || '';
        to = state.dateTo || '';
      }
      const rangeStart = from && to ? (from < to ? from : to) : from;
      const rangeEnd = from && to ? (from < to ? to : from) : to;
      updateMdRangeHeadline(screen);
      let html = '';
      for (let i = 0; i < 42; i++) {
        let dayNum;
        let cellMonth = month;
        let cellYear = year;
        let muted = false;
        if (i < startPad) {
          dayNum = prevDays - startPad + i + 1;
          cellMonth = month - 1;
          if (cellMonth < 0) { cellMonth = 11; cellYear -= 1; }
          muted = true;
        } else if (i >= startPad + daysInMonth) {
          dayNum = i - startPad - daysInMonth + 1;
          cellMonth = month + 1;
          if (cellMonth > 11) { cellMonth = 0; cellYear += 1; }
          muted = true;
        } else {
          dayNum = i - startPad + 1;
        }
        const iso = cellYear + '-' + String(cellMonth + 1).padStart(2, '0') + '-' + String(dayNum).padStart(2, '0');
        const classes = ['ap-cal-day'];
        if (muted) classes.push('is-muted');
        if (rangeStart && rangeEnd && iso >= rangeStart && iso <= rangeEnd) classes.push('is-in-range');
        if (rangeStart && iso === rangeStart) classes.push('is-start', 'is-selected');
        if (rangeEnd && iso === rangeEnd) classes.push('is-end', 'is-selected');
        if (state.pickStart && iso === state.pickStart) classes.push('is-selected', 'is-start');
        html += '<button type="button" class="' + classes.join(' ') + '" data-ledger-cal-day="' + iso + '" data-ledger-cal-screen="' + screen + '"><span class="ap-cal-day-num">' + dayNum + '</span></button>';
      }
      grid.innerHTML = html;
    }

    function commitLedgerDateRange(screen, dateFrom, dateTo, cleared) {
      const state = ledgerState[screen];
      if (!state) return;
      state.dateFrom = dateFrom || '';
      state.dateTo = dateTo || '';
      state.cleared = !!cleared;
      state.pickStart = null;
      state.draftFrom = state.dateFrom;
      state.draftTo = state.dateTo;
      syncLedgerDateInputs(screen);
      closeAllLedgerDatePanels();
      if (screen === 'cash-ledger') loadCashLedgerScreen();
      else if (screen === 'pay-tip') loadPayrollTips();
      else if (screen === 'approvals') loadApprovals(approvalsView);
      else if (screen === 'ledger') loadLedgerScreen(screen);
      else if (screen === 'dashboard') {
        if (cleared) seedDashboardDates();
        else mdPeriod = 'custom';
        loadDashboard();
      }
    }

    function onLedgerCalDay(screen, iso) {
      const state = ledgerState[screen];
      if (!state || !iso) return;
      if (!state.pickStart) {
        state.pickStart = iso;
        state.draftFrom = iso;
        state.draftTo = '';
        updateMdRangeHeadline(screen);
        renderLedgerCalendar(screen);
        return;
      }
      let from = state.pickStart;
      let to = iso;
      if (from > to) { const tmp = from; from = to; to = tmp; }
      state.draftFrom = from;
      state.draftTo = to;
      state.pickStart = null;
      updateMdRangeHeadline(screen);
      renderLedgerCalendar(screen);
    }

    function ledgerKindForScreen(screen) {
      return 'all';
    }

    function filterLedgerRows(screen, rows, tab) {
      const list = Array.isArray(rows) ? rows : [];
      if (screen === 'ledger') {
        if (tab === 'purchase') return list.filter((r) => r.entry_kind === 'purchase');
        if (tab === 'expense') return list.filter((r) => r.entry_kind !== 'purchase');
        return list;
      }
      if (tab === 'open') {
        return list.filter((r) => r.settlement_status === 'outstanding' || r.settlement_status === 'partial');
      }
      if (tab === 'cleared') {
        return list.filter((r) => r.settlement_status === 'cleared');
      }
      return list;
    }

    function computeLedgerKpisFromRows(rows) {
      const list = Array.isArray(rows) ? rows : [];
      const purchase = list.filter((r) => r.entry_kind === 'purchase');
      const expense = list.filter((r) => r.entry_kind !== 'purchase');
      const outstanding = list.filter((r) => {
        const s = String(r.settlement_status || '');
        return s === 'outstanding' || s === 'partial';
      });
      const cleared = list.filter((r) => String(r.settlement_status || '') === 'cleared');
      const sumAmt = (arr) => Math.round(arr.reduce((sum, r) => sum + (Number(r.amount) || 0), 0) * 100) / 100;
      const sumBal = (arr) => Math.round(arr.reduce((sum, r) => sum + (Number(r.balance) || 0), 0) * 100) / 100;
      return {
        purchase_total: sumAmt(purchase),
        purchase_count: purchase.length,
        expense_total: sumAmt(expense),
        expense_count: expense.length,
        outstanding_total: sumBal(outstanding),
        outstanding_count: outstanding.length,
        cleared_total: sumAmt(cleared),
        cleared_count: cleared.length,
      };
    }

    function renderLedgerKpis(screen, totals, tab) {
      const el = document.getElementById(screen + '-kpis');
      if (!el) return;
      const t = totals || {};
      const mode = tab || 'all';
      const card = (tone, label, value, meta) =>
        '<div class="ap-kpi md-kpi--' + tone + '">' +
          mdKpiWave() +
          '<div class="ap-kpi-label">' + label + '</div>' +
          '<div class="ap-kpi-value">' + value + '</div>' +
          '<div class="ap-kpi-meta">' + meta + '</div>' +
        '</div>';
      const cards = [];
      if (mode !== 'expense') {
        cards.push(card('blue', 'Purchases', formatInr(t.purchase_total), (t.purchase_count || 0) + ' entries'));
      }
      if (mode !== 'purchase') {
        cards.push(card('orange', 'Expenses', formatInr(t.expense_total), (t.expense_count || 0) + ' entries'));
      }
      cards.push(card('purple', 'Outstanding', formatInr(t.outstanding_total), (t.outstanding_count || 0) + ' open'));
      cards.push(card('green', 'Cleared', formatInr(t.cleared_total), (t.cleared_count || 0) + ' cleared'));
      el.classList.toggle('ap-kpi-grid--trio', cards.length === 3);
      el.innerHTML = cards.join('');
    }

    function updateLedgerTabCounts(screen) {
      const state = ledgerState[screen];
      if (!state) return;
      const rows = state.rows || [];
      const allEl = document.getElementById('ledger-count-all');
      const pEl = document.getElementById('ledger-count-purchase');
      const eEl = document.getElementById('ledger-count-expense');
      if (allEl) allEl.textContent = String(rows.length);
      if (pEl) pEl.textContent = String(rows.filter((r) => r.entry_kind === 'purchase').length);
      if (eEl) eEl.textContent = String(rows.filter((r) => r.entry_kind !== 'purchase').length);
    }

    function setLedgerChrome(screen, tab) {
