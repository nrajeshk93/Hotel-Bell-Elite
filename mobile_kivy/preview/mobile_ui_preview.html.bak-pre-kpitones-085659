        if (!day) return;
        attDateState.draft = day.getAttribute('data-att-cal-day') || '';
        renderAttCalendar();
      });
      document.getElementById('pay-att-date-today')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        attDateState.draft = attTodayIso();
        const parts = attDateState.draft.split('-');
        attDateState.calMonth = new Date(Number(parts[0]), Number(parts[1]) - 1, 1);
        renderAttCalendar();
      });
      document.addEventListener('click', (event) => {
        const chip = document.getElementById('pay-att-date-chip');
        if (!chip || !chip.classList.contains('is-open')) return;
        if (chip.contains(event.target)) return;
        closeAttDatePanel();
      });

      document.getElementById('pay-att-list')?.addEventListener('click', (event) => {
        const mark = event.target.closest('[data-att-mark]');
        if (!mark || mark.disabled) return;
        const card = mark.closest('[data-pay-att-emp]');
        if (!card) return;
        markPayrollAttendance(card.getAttribute('data-pay-att-emp'), mark.getAttribute('data-att-mark') || '');
      });
      
      
      document.getElementById('pay-cr-emp')?.addEventListener('input', (event) => {
        const idEl = document.getElementById('pay-cr-emp-id');
        if (idEl) idEl.value = '';
        renderCrEmpSuggest(event.target.value || '');
      });
      document.getElementById('pay-cr-emp')?.addEventListener('focus', (event) => {
        if (String(event.target.value || '').trim()) renderCrEmpSuggest(event.target.value || '');
      });
      document.getElementById('pay-cr-emp-suggest')?.addEventListener('click', (event) => {
        const item = event.target.closest('[data-cr-emp-idx]');
        if (!item) return;
        const box = document.getElementById('pay-cr-emp-suggest');
        const idx = Number(item.getAttribute('data-cr-emp-idx'));
        const emp = box && box._matches && box._matches[idx];
        if (emp) pickCrEmployee(emp);
      });
      document.addEventListener('click', (event) => {
        const field = document.getElementById('pay-cr-emp');
        const box = document.getElementById('pay-cr-emp-suggest');
        if (!box || !box.classList.contains('is-open')) return;
        if ((field && field.contains(event.target)) || (box && box.contains(event.target))) return;
        closeCrEmpSuggest();
      });

      document.getElementById('pay-cr-date-trigger')?.addEventListener('click', (event) => {
        event.preventDefault();
        openCrDatePanel();
      });
      document.getElementById('pay-cr-date-prev')?.addEventListener('click', () => {
        if (!crDateState.entryCalMonth) crDateState.entryCalMonth = new Date();
        crDateState.entryCalMonth = new Date(crDateState.entryCalMonth.getFullYear(), crDateState.entryCalMonth.getMonth() - 1, 1);
        renderCrCalendar();
      });
      document.getElementById('pay-cr-date-next')?.addEventListener('click', () => {
        if (!crDateState.entryCalMonth) crDateState.entryCalMonth = new Date();
        crDateState.entryCalMonth = new Date(crDateState.entryCalMonth.getFullYear(), crDateState.entryCalMonth.getMonth() + 1, 1);
        renderCrCalendar();
      });
      document.getElementById('pay-cr-date-grid')?.addEventListener('click', (event) => {
        const day = event.target.closest('[data-cr-cal-day]');
        if (!day) return;
        crDateState.draft = day.getAttribute('data-cr-cal-day') || '';
        renderCrCalendar();
      });
      document.getElementById('pay-cr-date-today')?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        crDateState.draft = crTodayIso();
        const parts = crDateState.draft.split('-');
        crDateState.entryCalMonth = new Date(Number(parts[0]), Number(parts[1]) - 1, 1);
        renderCrCalendar();
      });
      document.addEventListener('click', (event) => {
        const entryChip = document.getElementById('pay-cr-date-chip');
        if (!entryChip || !entryChip.classList.contains('is-open')) return;
        if (entryChip.contains(event.target)) return;
        closeCrDatePanels();
      });

      document.getElementById('pay-cr-add-btn')?.addEventListener('click', addPayrollCredit);
      document.getElementById('pay-cr-open-add')?.addEventListener('click', () => {
        resetPayrollCreditForm();
