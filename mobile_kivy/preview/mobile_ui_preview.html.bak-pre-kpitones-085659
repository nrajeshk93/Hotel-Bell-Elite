      const unread = !!(meta && meta.unread) || notifItems.length > 0;
      if (btn) btn.classList.toggle('has-unread', unread);
      if (home) {
        if (!notifItems.length) home.textContent = 'Notifications: none';
        else home.textContent = 'Notifications: ' + notifItems.length + ' — ' + (notifItems[0].title || 'Update');
