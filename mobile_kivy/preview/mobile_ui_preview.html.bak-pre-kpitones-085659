      if (titleEl) {
        titleEl.textContent = active
          ? ('POS · ' + posOutletLabel())
          : 'Hotel Bell Elite';
      }
    }

    function calcPosTotals() {
      const gross = posState.lines.reduce((sum, line) => sum + (Number(line.rate) || 0) * (Number(line.qty) || 0), 0);
      const discount = Math.round(gross * (Number(posState.discountPct) || 0) / 100 * 100) / 100;
      const afterDisc = Math.max(0, gross - discount);
      const service = Math.round(afterDisc * (Number(posState.servicePct) || 0) / 100 * 100) / 100;
      const tip = Math.round((Number(posState.tip) || 0) * 100) / 100;
      const inclusive = afterDisc + service + tip;
      const taxable = inclusive > 0 ? inclusive / 1.05 : 0;
      const cgst = Math.round(taxable * 0.025 * 100) / 100;
      const sgst = Math.round(taxable * 0.025 * 100) / 100;
      const rawTotal = inclusive;
      const rounded = Math.round(rawTotal);
      const roundOff = Math.round((rounded - rawTotal) * 100) / 100;
      return {
        subtotal: Math.round(gross * 100) / 100,
        discount,
        service,
        tip,
        cgst,
        sgst,
        gst: Math.round((cgst + sgst) * 100) / 100,
        roundOff,
        total: Math.round((rawTotal + roundOff) * 100) / 100,
      };
    }

    function renderPosLines() {
      const host = document.getElementById('pos-lines');
      const empty = document.getElementById('pos-empty');
      if (!host) return;
      if (!posState.lines.length) {
        host.innerHTML = '';
        if (empty) empty.hidden = false;
      } else {
        if (empty) empty.hidden = true;
        host.innerHTML = posState.lines.map((line, idx) => {
          const amt = (Number(line.rate) || 0) * (Number(line.qty) || 0);
          return (
            '<div class="pos-line" data-idx="' + idx + '">' +
              '<button type="button" data-pos-remove="' + idx + '">' + escapeHtml(line.name) + '</button>' +
              '<span>' + escapeHtml(String(line.qty)) + '</span>' +
              '<span>' + moneyInr(line.rate).replace('₹', '') + '</span>' +
              '<span>' + moneyInr(amt).replace('₹', '') + '</span>' +
            '</div>'
          );
        }).join('');
      }
      const t = calcPosTotals();
      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = moneyInr(val);
      };
      setTxt('pos-subtotal', t.subtotal);
      setTxt('pos-cgst', t.cgst);
      setTxt('pos-sgst', t.sgst);
      setTxt('pos-round', t.roundOff);
      setTxt('pos-total', t.total);
      syncPosSettleVisibility();
    }

    function addPosMenuItem(item) {
      if (!item) return;
      const existing = posState.lines.find((line) => String(line.menuId) === String(item.id) && line.name === item.name);
      if (existing) {
        existing.qty = (Number(existing.qty) || 0) + 1;
      } else {
        posState.lines.push({
          uid: uid8(),
          menuId: item.id,
          name: item.name || 'Item',
          rate: Number(item.rate || item.price || 0) || 0,
          qty: 1,
          category: item.category_name || item.category || '',
          variant: item.variant || '',
          kotSentQty: 0,
        });
      }
      renderPosLines();
      const search = document.getElementById('pos-menu-search');
      const suggest = document.getElementById('pos-menu-suggest');
      if (search) search.value = '';
      if (suggest) {
        suggest.classList.remove('is-open');
        suggest.innerHTML = '';
      }
    }

    function applyInvoiceToPos(invoice) {
      if (!invoice || typeof invoice !== 'object') {
        posState.invoiceId = null;
        posState.orderNo = null;
        posState.invoiceGenerated = false;
        posState.lines = [];
        renderPosLines();
        return;
      }
      posState.invoiceId = invoice.id || null;
      posState.orderNo = invoice.order_no || invoice.orderNo || null;
      posState.invoiceGenerated = !!(
        invoice.customer_bill_sent ||
        invoice.customerBillSent ||
        invoice.customer_bill
      );
      const nameEl = document.getElementById('pos-customer-name');
      const mobileEl = document.getElementById('pos-customer-mobile');
      const notesEl = document.getElementById('pos-notes');
      const typeEl = document.getElementById('pos-order-type');
      if (nameEl) nameEl.value = invoice.customer_name || invoice.customerName || '';
      if (mobileEl) {
        const mob = String(invoice.customer_mobile || invoice.customerMobile || '').replace(/\D/g, '');
        mobileEl.value = mob.slice(-10);
      }
      if (notesEl) {
        notesEl.value = invoice.notes || '';
        const count = document.getElementById('pos-notes-count');
        if (count) count.textContent = String((notesEl.value || '').length) + ' / 200';
      }
      if (typeEl && (invoice.order_type || invoice.orderType)) {
        const ot = invoice.order_type || invoice.orderType;
        const labels = { dine_in: 'Dine In', takeaway: 'Takeaway', delivery: 'Delivery' };
        setPosListboxValue(
          document.getElementById('pos-order-type-listbox'),
          ot,
          labels[ot] || ot
        );
      }
      posState.lines = [];
      for (const line of invoice.lines || []) {
        if (!line || typeof line !== 'object') continue;
        posState.lines.push({
          uid: String(line.uid || uid8()),
          menuId: line.menuId || line.menu_id || null,
          name: String(line.name || ''),
          rate: Number(line.rate || 0) || 0,
          qty: Number(line.qty || 1) || 1,
          category: line.category || '',
          variant: line.variant || '',
          kotSentQty: Number(
            line.kotSentQty != null ? line.kotSentQty
              : (line.kot_sent_qty != null ? line.kot_sent_qty : line.sent_qty)
          ) || 0,
        });
      }
      renderPosLines();
    }

    function closeAllPosListboxes(exceptRoot) {
      document.querySelectorAll('[data-pos-listbox].is-open').forEach((root) => {
        if (exceptRoot && root === exceptRoot) return;
        root.classList.remove('is-open');
        const trigger = root.querySelector('.pos-listbox-trigger');
        const menu = root.querySelector('.pos-listbox-menu');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        if (menu) menu.hidden = true;
