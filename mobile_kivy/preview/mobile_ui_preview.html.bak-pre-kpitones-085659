    function mdSparkSvg(series, tone) {
      const pts = (series || []).map((p) => Number(p && p.value != null ? p.value : p) || 0);
      if (!pts.length) return '';
      const w = 120;
      const h = 28;
      const max = Math.max(...pts, 1);
      const min = Math.min(...pts, 0);
      const span = Math.max(max - min, 1);
      const step = pts.length > 1 ? w / (pts.length - 1) : w;
      const coords = pts.map((v, i) => {
        const x = i * step;
        const y = h - ((v - min) / span) * (h - 4) - 2;
        return x.toFixed(1) + ',' + y.toFixed(1);
      });
      const color = ({
        blue: '#0061FF',
        purple: '#7C3AED',
        green: '#16A34A',
        orange: '#EA580C',
        red: '#DC2626',
      })[tone] || '#0061FF';
      return (
        '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none" aria-hidden="true">' +
          '<polyline fill="none" stroke="' + color + '" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" points="' +
          coords.join(' ') + '"/></svg>'
      );
    }

