    async function addPayrollCredit() {
      const status = document.getElementById('pay-cr-form-status');
      const empId = String((document.getElementById('pay-cr-emp-id') || {}).value || '').trim();
      const empText = String((document.getElementById('pay-cr-emp') || {}).value || '').trim();
      const payload = {
        employee_id: empId || empText,
        date: (typeof crDateState !== 'undefined' && crDateState.entryDate) || (document.getElementById('pay-cr-date') || {}).value,
        description: (document.getElementById('pay-cr-desc') || {}).value,
        amount: (document.getElementById('pay-cr-amount') || {}).value,
        transaction_type: (document.getElementById('pay-cr-type') || {}).value || 'credit',
        payment_type: (document.getElementById('pay-cr-paytype') || {}).value || 'cash',
        transaction_id: (document.getElementById('pay-cr-txn') || {}).value || '',
      };
      if (!payload.employee_id) {
        if (status) {
          status.hidden = false;
          status.textContent = 'Select an employee from the list.';
        }
        return;
      }
      try {
        const res = await previewFetch('/preview-api/payroll/credits', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (status) {
            status.hidden = false;
            status.textContent = (data && data.error) || 'Could not save.';
          }
          return;
        }
        resetPayrollCreditForm();
        setPayrollCreditAddOpen(false);
        loadPayrollCredits();
      } catch (_err) {
        if (status) {
          status.hidden = false;
          status.textContent = 'Could not save credit.';
        }
      }
    }

    async function loadPayrollTips() {
      const status = document.getElementById('pay-tip-status');
      const from = (document.getElementById('pay-tip-from') || {}).value || '';
      const to = (document.getElementById('pay-tip-to') || {}).value || '';
      const location = (document.getElementById('pay-tip-location') || {}).value || 'All';
      if (status) status.textContent = 'Loading tips…';
      try {
        const res = await previewFetch('/preview-api/payroll/tips' + payQs({ date_from: from, date_to: to, location: location }));
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (status) status.textContent = (data && data.error) || 'Could not load tips.';
          return;
        }
        if (status) status.textContent = 'Tips ' + payMoney(data.grand_total);
        const kpis = document.getElementById('pay-tip-kpis');
        if (kpis) {
          kpis.classList.add('ap-kpi-grid');
          kpis.innerHTML = [
            ['Total', data.grand_total],
            ['Hotel', data.hotel_total],
            ['Bar', data.bar_total],
            ['Restaurant', data.restaurant_total],
          ].map((row) => '<div class="ap-kpi"><div class="ap-kpi-label">' + row[0] + '</div><div class="ap-kpi-value">' + payMoney(row[1]) + '</div></div>').join('');
        }
        const top = document.getElementById('pay-tip-top');
        if (top) {
          const rows = (data.top_employees || []).map((e) => (
            '<article class="ap-card"><div class="ap-card-top"><div class="ap-card-code">' + escapeHtml(e.employee_name || '') + '</div><div class="ap-card-amt">' + payMoney(e.total) + '</div></div><div class="ap-card-meta">' + escapeHtml(e.employee_code || '') + '</div></article>'
          )).join('');
          top.innerHTML = rows || '<article class="ap-card"><div class="ap-card-code">No tips in this range.</div></article>';
        }
        const recent = document.getElementById('pay-tip-recent');
        if (recent) {
          recent.innerHTML = (data.recent || []).map((r) => (
            '<article class="ap-card"><div class="ap-card-top"><div class="ap-card-code">' + escapeHtml(r.employee_name || '') + '</div><div class="ap-card-amt">' + payMoney(r.amount) + '</div></div><div class="ap-card-meta">' + escapeHtml((r.date || '') + ' · ' + (r.location || '')) + '</div></article>'
          )).join('');
        }
        const dateEl = document.getElementById('pay-tip-date');
        if (dateEl && !dateEl.value) dateEl.value = (typeof todayIso === 'function' ? todayIso() : new Date().toISOString().slice(0, 10));
        if (typeof syncTipEntryDisplay === 'function') syncTipEntryDisplay();
        if (typeof syncLedgerDateInputs === 'function') syncLedgerDateInputs('pay-tip');
      } catch (_err) {
        if (status) status.textContent = 'Could not load tips.';
      }
    }

