    bindPayrollUi();

    const _go = go;
    go = function (screen) {
      if (typeof setNotifOpen === 'function') setNotifOpen(false);
      screen = _go(screen) || screen || 'home';
      mdActiveScreen = screen;
      const isPos = screen === 'pos' || screen === 'pos-bar';
      const isKot = screen === 'kot' || screen === 'kot-bar';
      if (isPos) {
        setPosOutlet(screen === 'pos-bar' ? 'bar' : 'restaurant');
      }
      setPosChrome(isPos);
      if (screen === 'approvals') {
        closeApprovalsDetail();
        loadApprovals(approvalsView);
        startApprovalsAutoRefresh();
      } else {
        stopApprovalsAutoRefresh();
        closeApprovalsDetail();
      }
      if (screen === 'indent-approvals') {
        closeIndentReject();
        loadIndents(indentView);
      } else {
        closeIndentReject();
      }
      if (screen === 'indent-request') {
        loadIrCatalog();
        renderIrLines();
      }
      if (screen === 'dashboard') {
        loadDashboard();
      }
      if (isPos) {
        loadPosScreen();
      }
      if (isKot) {
        setKotOutlet(screen === 'kot-bar' ? 'bar' : 'restaurant');
        closeKotSlip();
        closeKotReason();
        const kotPanel = document.querySelector('.panel-kot');
        if (kotPanel) {
          kotPanel.classList.toggle('is-bar', screen === 'kot-bar');
          kotPanel.classList.toggle('is-restaurant', screen !== 'kot-bar');
        }
        const headTitle = document.getElementById('kot-title') || document.querySelector('.kot-head h2');
        if (headTitle) headTitle.textContent = screen === 'kot-bar' ? 'Bar KOT' : 'Restaurant KOT';
        loadKotTokens({ force: true });
      }
      if (screen === 'home') {
        updateHomeWelcome();
        loadHomeSummary();
      }
      if (screen === 'ledger') {
        loadLedgerScreen(screen);
      }
      if (screen === 'cash-ledger') {
        loadCashLedgerScreen();
      }
      if (screen === 'payroll-employee') loadPayrollEmployees();
      if (screen === 'payroll-attendance') loadPayrollAttendance();
      if (screen === 'payroll-credit') {
        setPayrollCreditAddOpen(false);
        setPayrollCreditDetailOpen(false);
        loadPayrollCredits();
      }
      if (screen === 'payroll-tips') loadPayrollTips();
    };
    // Keep preview signed in across refresh for 30 days (explicit Logout clears it).
    (async function restorePreviewSession() {
      const auth = readPreviewAuth();
      if (!auth || !auth.token) return;
      const sessionPath = USE_FLASK_SESSION ? '/api/mobile/session' : '/preview-api/session';
      try {
        const res = await previewFetch(sessionPath);
        const data = await res.json();
        if (!res.ok || !data || !data.ok) {
          clearPreviewAuth();
          return;
        }
        previewAccess = data.access || {};
        writePreviewAuth(auth.screen || 'home', {
          token: auth.token,
          access: previewAccess,
          displayName: data.display_name || auth.displayName || '',
          username: data.username || auth.username || '',
        });
        updateHomeWelcome(data.display_name || auth.displayName || '');
        showWorkspace(auth.screen || 'home', data.display_name || auth.displayName || '');
      } catch (_err) {
        clearPreviewAuth();
      }
    })();
