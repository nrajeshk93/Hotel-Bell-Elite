    function moneyInr(n) {
      const v = Math.round((Number(n) || 0) * 100) / 100;
      return '₹' + v.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function uid8() {
      return Math.random().toString(16).slice(2, 10);
