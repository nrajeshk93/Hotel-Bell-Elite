      if (
        lower.includes('connection refused') ||
        lower.includes('errno 61') ||
        lower.includes('urlopen error') ||
        lower.includes('failed to fetch') ||
        lower.includes('networkerror') ||
        lower.includes('server offline') ||
        lower.includes('start flask')
      ) {
        return 'Unable to load dashboard. Pull down to refresh.';
