      pushNativeNotifications(notifItems);
      if (!list) return;
      if (!notifItems.length) {
        list.innerHTML = '<div class="notif-empty">' +
          escapeHtml((meta && meta.error) ? String(meta.error) : 'All caught up. No new notifications.') +
