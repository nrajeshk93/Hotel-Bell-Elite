      document.getElementById('pay-tip-from')?.addEventListener('change', loadPayrollTips);
      document.getElementById('pay-tip-to')?.addEventListener('change', loadPayrollTips);
      document.getElementById('pay-tip-location')?.addEventListener('change', loadPayrollTips);
      document.getElementById('pay-tip-add-btn')?.addEventListener('click', addPayrollTip);
      document.querySelectorAll('[data-tip-location]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-tip-location') || 'All';
          document.querySelectorAll('[data-tip-location]').forEach((b) => {
            b.classList.toggle('is-active', b.getAttribute('data-tip-location') === val);
          });
          const root = document.getElementById('pay-tip-location-listbox');
          if (typeof setPosListboxValue === 'function' && root) setPosListboxValue(root, val, val);
          else {
            const hidden = document.getElementById('pay-tip-location');
            const label = document.getElementById('pay-tip-location-label');
