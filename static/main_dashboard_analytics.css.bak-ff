/* Retail Intelligence Dashboard — premium SaaS analytics */
.rdx-content {
  max-width: none;
  margin: 0 auto;
  padding: 20px 24px 56px;
  flex: 1;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background:
    radial-gradient(1200px 400px at 10% -10%, rgba(37, 99, 235, 0.08), transparent 55%),
    radial-gradient(900px 300px at 90% 0%, rgba(14, 165, 233, 0.06), transparent 50%),
    #f8fafc;
}

.rdx-hero {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 22px;
}

.rdx-hero h1 {
  margin: 0 0 6px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #0f172a;
}

.rdx-hero p {
  margin: 0;
  font-size: 14px;
  color: #64748b;
  font-weight: 500;
}

.rdx-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.rdx-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  font-size: 12px;
  font-weight: 600;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s ease;
  text-decoration: none;
}

.rdx-pill:hover,
.rdx-pill.is-active {
  border-color: #93c5fd;
  color: #2563eb;
  background: #eff6ff;
}

.rdx-select {
  height: 36px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #fff;
  padding: 0 12px;
  font: 600 12px Inter, system-ui, sans-serif;
  color: #334155;
}

.rdx-kpi-grid.pl-summary-row,
.rdx-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  gap: 14px;
  margin-bottom: 24px;
  width: 100%;
}

.rdx-kpi {
  position: relative;
  margin: 0;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.rdx-kpi:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

.rdx-kpi .rdx-kpi-body {
  width: 100%;
}

.rdx-kpi-change {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.rdx-kpi-change.up { color: #16a34a; }
.rdx-kpi-change.down { color: #dc2626; }
.rdx-kpi-change.flat { color: #64748b; }

.rdx-spark {
  height: 44px;
  margin: 0;
  width: 100%;
}

.rdx-spark-ltr-mask {
  margin: 0 12px 12px;
  overflow: hidden;
  width: calc(100% - 24px);
  will-change: width;
  box-sizing: border-box;
}

.rdx-spark-ltr-mask > .rdx-spark {
  height: 44px;
  min-height: 44px;
}

@media (min-width: 1280px) {
  .rdx-kpi-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
}

@media (min-width: 768px) and (max-width: 1279px) {
  .rdx-kpi-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .rdx-kpi-grid {
    grid-template-columns: 1fr;
  }
}

.rdx-grid-2 {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 16px;
  margin-bottom: 16px;
}

.rdx-grid-dow-heat {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  align-items: start;
}

.rdx-grid-top-items {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
  align-items: stretch;
}

.rdx-grid-heatmap-payment {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
  align-items: stretch;
  gap: 16px;
  margin-bottom: 16px;
}

.rdx-grid-heatmap-payment > .rdx-card,
.rdx-grid-top-items > .rdx-card {
  min-width: 0;
  max-width: 100%;
  width: auto;
  align-self: stretch;
}

/* Half-width payment card: chart on top, Digital/Cash/Credit KPIs in a row */
.rdx-grid-heatmap-payment > .rdx-payment-mode {
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
}

.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-body {
  grid-template-columns: 1fr;
  gap: 14px;
  flex: 1 1 auto;
  min-width: 0;
}

.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-chart-col,
.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-chart-ltr-mask,
.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-chart {
  min-width: 0;
  max-width: 100%;
  width: 100%;
  box-sizing: border-box;
}

.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-chart {
  min-height: 200px;
}

.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-kpis {
  flex-direction: row;
  align-items: stretch;
}

.rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-kpi {
  flex: 1 1 0;
  min-width: 0;
}

.rdx-grid-heatmap-payment > .rdx-sales-heatmap-card {
  overflow: hidden;
  margin-bottom: 0;
}

.rdx-sales-heatmap-card {
  padding: 20px;
  border: 1px solid #f1f5f9;
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.rdx-heatmap-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin: 0;
  padding: 0 0 4px;
  width: 100%;
  min-width: 0;
}

.rdx-heatmap {
  display: grid;
  grid-template-columns: minmax(88px, max-content) repeat(7, minmax(0, 1fr));
  gap: 6px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.rdx-heatmap-corner {
  min-height: 24px;
}

.rdx-heatmap-col-head {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #94a3b8;
  text-align: center;
  padding: 2px 0 4px;
}

.rdx-heatmap-row-label {
  font-size: 10px;
  font-weight: 600;
  color: #64748b;
  display: flex;
  align-items: center;
  padding: 0 8px 0 0;
  white-space: nowrap;
  cursor: pointer;
  border: none;
  background: transparent;
  font-family: inherit;
  text-align: left;
  border-radius: 6px;
  transition: color 0.15s ease, background 0.15s ease;
}

.rdx-heatmap-row-label:hover {
  color: #2563eb;
  background: #eff6ff;
}

.rdx-heatmap-cell {
  aspect-ratio: 1;
  min-height: 24px;
  min-width: 0;
  width: 100%;
  height: auto;
  max-width: none;
  max-height: none;
  justify-self: stretch;
  border-radius: 6px;
  border: 1px solid transparent;
  cursor: default;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

/* Hold until scrolled into view, then cascade fill like sales trend */
.rdx-sales-heatmap-card.is-pending .rdx-heatmap-col-head,
.rdx-sales-heatmap-card.is-pending .rdx-heatmap-row-label,
.rdx-sales-heatmap-card.is-pending .rdx-heatmap-cell {
  opacity: 0;
  transform: scale(0.55);
}

.rdx-sales-heatmap-card.is-pending .rdx-heatmap-legend-label {
  opacity: 0;
}

.rdx-sales-heatmap-card.is-pending .rdx-heatmap-legend-bar {
  transform: scaleX(0);
  transform-origin: left center;
}

@keyframes rdx-hm-cell-enter {
  from {
    opacity: 0;
    transform: scale(0.55);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes rdx-hm-label-enter {
  from {
    opacity: 0;
    transform: translateX(-8px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes rdx-hm-legend-wipe {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@keyframes rdx-hm-legend-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.rdx-sales-heatmap-card.is-entering .rdx-heatmap-col-head {
  animation: rdx-hm-cell-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--rdx-hm-i, 0) * 40ms);
}

.rdx-sales-heatmap-card.is-entering .rdx-heatmap-row-label {
  animation: rdx-hm-label-enter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(0.08s + var(--rdx-hm-i, 0) * 70ms);
}

.rdx-sales-heatmap-card.is-entering .rdx-heatmap-cell {
  animation: rdx-hm-cell-enter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(0.12s + var(--rdx-hm-i, 0) * 38ms);
}

.rdx-sales-heatmap-card.is-entering .rdx-heatmap-legend-bar {
  transform-origin: left center;
  animation: rdx-hm-legend-wipe 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: 0.35s;
}

.rdx-sales-heatmap-card.is-entering .rdx-heatmap-legend-label {
  animation: rdx-hm-legend-fade 0.45s ease both;
  animation-delay: 0.45s;
}

@media (prefers-reduced-motion: reduce) {
  .rdx-sales-heatmap-card.is-pending .rdx-heatmap-col-head,
  .rdx-sales-heatmap-card.is-pending .rdx-heatmap-row-label,
  .rdx-sales-heatmap-card.is-pending .rdx-heatmap-cell,
  .rdx-sales-heatmap-card.is-pending .rdx-heatmap-legend-label {
    opacity: 1;
    transform: none;
  }

  .rdx-sales-heatmap-card.is-pending .rdx-heatmap-legend-bar {
    transform: none;
  }

  .rdx-sales-heatmap-card.is-entering .rdx-heatmap-col-head,
  .rdx-sales-heatmap-card.is-entering .rdx-heatmap-row-label,
  .rdx-sales-heatmap-card.is-entering .rdx-heatmap-cell,
  .rdx-sales-heatmap-card.is-entering .rdx-heatmap-legend-bar,
  .rdx-sales-heatmap-card.is-entering .rdx-heatmap-legend-label {
    animation: none;
  }
}

.rdx-heatmap-cell.is-active {
  cursor: pointer;
}

.rdx-heatmap-cell.is-active:hover,
.rdx-heatmap-cell.is-active.is-hover {
  transform: scale(1.08);
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
  border-color: #93c5fd;
  z-index: 2;
  position: relative;
}

.rdx-heatmap-cell.is-out {
  background: #f8fafc;
  border-color: #f1f5f9;
  cursor: default;
}

.rdx-heatmap-cell.is-empty {
  background: #f1f5f9;
  border-color: #eef2f7;
}

.rdx-heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: stretch;
  gap: 10px;
  width: 100%;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
  box-sizing: border-box;
}

.rdx-heatmap-legend-label {
  font-size: 10px;
  font-weight: 600;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.rdx-heatmap-legend-bar {
  flex: 1 1 auto;
  min-width: 0;
  max-width: none;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, #eff6ff 0%, #dbeafe 25%, #93c5fd 50%, #3b82f6 75%, #2563eb 100%);
  box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.12);
}

.rdx-heatmap-tooltip {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 10000;
  pointer-events: none;
  padding: 10px 12px;
  border-radius: 10px;
  background: #1e293b;
  color: #f8fafc;
  font-size: 12px;
  line-height: 1.45;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.22);
  max-width: 220px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.12s ease;
  will-change: transform;
}

.rdx-heatmap-tooltip.is-visible {
  opacity: 1;
  visibility: visible;
}

.rdx-heatmap-tooltip.is-measuring {
  opacity: 0;
  visibility: hidden;
  transition: none;
}

.rdx-heatmap-tooltip strong {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #93c5fd;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.rdx-heatmap-tooltip .rdx-ht-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.rdx-heatmap-tooltip .rdx-ht-row + .rdx-ht-row {
  margin-top: 4px;
}

.rdx-heatmap-tooltip .rdx-ht-up {
  color: #34d399;
  font-weight: 700;
}

.rdx-heatmap-tooltip .rdx-ht-down {
  color: #f87171;
  font-weight: 700;
}

@media (max-width: 1100px) {
  .rdx-grid-dow-heat,
  .rdx-grid-top-items,
  .rdx-grid-heatmap-payment {
    grid-template-columns: 1fr !important;
  }

  .rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-body {
    grid-template-columns: minmax(0, 3fr) minmax(120px, 1fr);
  }

  .rdx-grid-heatmap-payment > .rdx-payment-mode .rdx-pm-kpis {
    flex-direction: column;
  }
}

@media (max-width: 767px) {
  .rdx-heatmap {
    grid-template-columns: minmax(72px, max-content) repeat(7, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .rdx-heatmap-cell {
    min-height: 22px;
    max-width: none;
    max-height: none;
    border-radius: 6px;
  }
}

.rdx-grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.rdx-card {
  border-radius: 16px;
  border: 1px solid #e2e8f0;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px rgba(15, 23, 42, 0.04);
  padding: 16px 18px 14px;
}

.rdx-card-full { margin-bottom: 16px; }

/* Sales trend section */
.rdx-sales-trend {
  border-radius: 20px;
  padding: 24px 28px 20px;
  background: #ffffff;
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
}

.rdx-st-head {
  margin-bottom: 20px;
}

.rdx-st-title {
  margin: 0;
  font-family: Inter, Poppins, system-ui, sans-serif;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #334155;
}

.rdx-st-subtitle {
  margin: 6px 0 0;
  font-size: 14px;
  font-weight: 500;
  color: #94a3b8;
}

.rdx-st-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 24px;
}

.rdx-st-stat {
  padding: 14px 16px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
  text-align: center;
}

/* Hold off-screen until scrolled into view, then stagger left→right */
.rdx-sales-trend.is-pending .rdx-st-stat {
  opacity: 0;
  transform: translateX(-14px);
}

.rdx-chart-ltr-mask {
  width: 100%;
  overflow: hidden;
  will-change: width;
}

.rdx-chart-ltr-mask > .rdx-chart-sales {
  /* Full intrinsic width so the wipe reveals instead of squashing the canvas */
  width: 100%;
  min-height: 280px;
  box-sizing: border-box;
}

@keyframes rdx-st-enter {
  from {
    opacity: 0;
    transform: translateX(-14px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.rdx-sales-trend.is-entering .rdx-st-stat {
  animation: rdx-st-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--rdx-st-i, 0) * 90ms);
}

@media (prefers-reduced-motion: reduce) {
  .rdx-sales-trend.is-pending .rdx-st-stat {
    opacity: 1;
    transform: none;
  }

  .rdx-sales-trend.is-entering .rdx-st-stat {
    animation: none;
  }
}

.rdx-st-stat-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #94a3b8;
  margin-bottom: 8px;
  text-align: center;
}

.rdx-st-stat-value {
  font-size: 20px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.02em;
  line-height: 1.2;
  text-align: center;
}

.rdx-st-stat-meta {
  margin-top: 4px;
  font-size: 12px;
  font-weight: 500;
  color: #64748b;
  text-align: center;
}

.rdx-chart-sales {
  width: 100%;
  min-height: 320px;
}

@media (max-width: 900px) {
  .rdx-st-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .rdx-st-stats {
    grid-template-columns: 1fr;
  }
}

/* Top companies by sales */
.rdx-co-leaderboard {
  border-radius: 20px;
  border: 1px solid #e5e7eb;
  padding: 24px;
  background: #ffffff;
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
}

.rdx-co-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.rdx-co-title {
  margin: 0;
  font-family: Inter, Poppins, system-ui, sans-serif;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #334155;
  display: flex;
  align-items: center;
  gap: 6px;
}

.rdx-co-info {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
  cursor: help;
}

.rdx-co-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.rdx-co-row {
  padding: 16px 0;
  border-bottom: 1px solid #f1f5f9;
}

.rdx-co-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rdx-co-row-top {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.rdx-co-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
  height: 28px;
  padding: 0 8px;
  border-radius: 8px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  font-size: 12px;
  font-weight: 700;
  color: #64748b;
}

.rdx-co-name {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
  min-width: 0;
}

.rdx-co-sales {
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.rdx-co-bar {
  height: 8px;
  border-radius: 999px;
  background: #f1f5f9;
  overflow: hidden;
  margin-bottom: 8px;
}

.rdx-co-bar-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #3b82f6, #2563eb);
  width: 0%;
  transform-origin: left center;
}

.rdx-co-leaderboard.is-pending .rdx-co-row {
  opacity: 0;
  transform: translateX(-12px);
}

@keyframes rdx-co-row-enter {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.rdx-co-leaderboard.is-entering .rdx-co-row {
  animation: rdx-co-row-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--rdx-co-i, 0) * 100ms);
}

@media (prefers-reduced-motion: reduce) {
  .rdx-co-leaderboard.is-pending .rdx-co-row {
    opacity: 1;
    transform: none;
  }

  .rdx-co-leaderboard.is-entering .rdx-co-row {
    animation: none;
  }
}

.rdx-co-row-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.rdx-co-share {
  font-size: 13px;
  font-weight: 600;
  color: #64748b;
}

.rdx-co-growth {
  font-size: 13px;
  font-weight: 600;
}

.rdx-co-growth.up { color: #16a34a; }
.rdx-co-growth.down { color: #dc2626; }

.rdx-co-foot {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 20px;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #f1f5f9;
  font-size: 11px;
  font-weight: 500;
  color: #94a3b8;
}

.rdx-co-empty {
  margin: 0;
  padding: 12px 0;
  font-size: 13px;
  color: #94a3b8;
}

@media (max-width: 560px) {
  .rdx-co-row-top {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
  }

  .rdx-co-sales {
    grid-column: 2;
    justify-self: end;
  }
}

/* Sales contribution */
.rdx-sales-contrib {
  border-radius: 20px;
  border: 1px solid #e5e7eb;
  padding: 24px;
  background: #ffffff;
  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
}

.rdx-sc-head {
  margin-bottom: 20px;
}

.rdx-sc-title {
  margin: 0;
  font-family: Inter, Poppins, system-ui, sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.02em;
}

.rdx-sc-subtitle {
  margin: 6px 0 0;
  font-size: 14px;
  font-weight: 500;
  color: #94a3b8;
}

.rdx-sc-body {
  display: grid;
  grid-template-columns: minmax(120px, 148px) minmax(0, 1fr);
  gap: 16px;
  align-items: center;
}

.rdx-sc-chart-wrap {
  position: relative;
  width: 100%;
  max-width: 148px;
  margin: 0 auto;
  aspect-ratio: 1;
  container-type: size;
}

.rdx-sc-chart {
  width: 100%;
  height: 100%;
  min-height: 148px;
  position: relative;
  z-index: 1;
}

.rdx-sc-center {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  text-align: center;
  /* Keep copy inside the donut hole (~64% diameter). */
  padding: 20%;
  box-sizing: border-box;
}

.rdx-sc-center-label {
  font-size: clamp(9px, 7.5cqw, 11px);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #94a3b8;
  margin: 0 0 2px;
  line-height: 1.2;
}

.rdx-sc-center-value {
  font-size: clamp(11px, 11cqw, 15px);
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.03em;
  line-height: 1.15;
  max-width: 100%;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.rdx-sc-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-width: 0;
}

.rdx-sc-row {
  padding: 14px 0;
  border-bottom: 1px solid #f1f5f9;
  min-width: 0;
}

.rdx-sales-contrib.is-pending .rdx-sc-row,
.rdx-sales-contrib.is-pending .rdx-sc-center,
.rdx-sales-contrib.is-pending .rdx-sc-insight {
  opacity: 0;
  transform: translateX(-12px);
}

.rdx-sales-contrib.is-pending .rdx-sc-chart {
  opacity: 0;
  transform: scale(0.86);
}

@keyframes rdx-sc-row-enter {
  from {
    opacity: 0;
    transform: translateX(-12px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes rdx-sc-donut-enter {
  from {
    opacity: 0;
    transform: scale(0.86);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.rdx-sales-contrib.is-entering .rdx-sc-row {
  animation: rdx-sc-row-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(0.2s + var(--rdx-sc-i, 0) * 100ms);
}

.rdx-sales-contrib.is-entering .rdx-sc-center {
  animation: rdx-sc-row-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: 0.15s;
}

.rdx-sales-contrib.is-entering .rdx-sc-insight {
  animation: rdx-sc-row-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: 0.45s;
}

.rdx-sales-contrib.is-entering .rdx-sc-chart {
  animation: rdx-sc-donut-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  .rdx-sales-contrib.is-pending .rdx-sc-row,
  .rdx-sales-contrib.is-pending .rdx-sc-center,
  .rdx-sales-contrib.is-pending .rdx-sc-insight,
  .rdx-sales-contrib.is-pending .rdx-sc-chart {
    opacity: 1;
    transform: none;
  }

  .rdx-sales-contrib.is-entering .rdx-sc-row,
  .rdx-sales-contrib.is-entering .rdx-sc-center,
  .rdx-sales-contrib.is-entering .rdx-sc-insight,
  .rdx-sales-contrib.is-entering .rdx-sc-chart {
    animation: none;
  }
}

.rdx-sc-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rdx-sc-row-top {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  margin-bottom: 4px;
  min-width: 0;
}

.rdx-sc-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  flex-shrink: 0;
}

.rdx-sc-name {
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  min-width: 0;
  overflow: visible;
  text-overflow: unset;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
  line-height: 1.3;
}

.rdx-sc-pct {
  font-size: 18px;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.rdx-sc-amount {
  padding-left: 20px;
  font-size: 13px;
  font-weight: 500;
  color: #64748b;
}

.rdx-sc-insight {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #f1f5f9;
  font-size: 13px;
  color: #64748b;
  line-height: 1.5;
}

.rdx-sc-insight strong {
  display: block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #94a3b8;
  margin-bottom: 4px;
}

.rdx-sc-empty {
  margin: 0;
  font-size: 13px;
  color: #94a3b8;
}

@media (max-width: 760px) {
  .rdx-sc-body {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .rdx-sc-chart-wrap {
    max-width: 240px;
  }
}

/* Payment mode analysis */
.rdx-payment-mode {
  border-radius: 16px;
  border: 1px solid #f1f5f9;
  padding: 22px 24px;
  background: #ffffff;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

.rdx-pm-title {
  margin: 0 0 18px;
  font-family: Inter, Poppins, system-ui, sans-serif;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #334155;
}

.rdx-pm-body {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(140px, 1fr);
  gap: 24px;
  align-items: stretch;
}

.rdx-pm-chart-col {
  min-width: 0;
}

.rdx-pm-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 12px;
}

.rdx-pm-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
}

.rdx-pm-swatch {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  flex-shrink: 0;
}

.rdx-pm-legend-digital .rdx-pm-swatch { background: #2563eb; }
.rdx-pm-legend-cash .rdx-pm-swatch { background: #34d399; }
.rdx-pm-legend-credit .rdx-pm-swatch { background: #f59e0b; }

.rdx-pm-chart {
  width: 100%;
  min-height: 260px;
  box-sizing: border-box;
}

.rdx-chart-ltr-mask > .rdx-pm-chart {
  /* Full intrinsic width so the wipe reveals instead of squashing the canvas */
  width: 100%;
  min-height: 260px;
  box-sizing: border-box;
}

.rdx-pm-kpis {
  display: flex;
  flex-direction: column;
  gap: 16px;
  justify-content: center;
}

.rdx-pm-kpi {
  padding: 18px 16px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
  text-align: center;
}

/* Hold off-screen until scrolled into view, then stagger left→right */
.rdx-payment-mode.is-pending .rdx-pm-kpi {
  opacity: 0;
  transform: translateX(-14px);
}

@keyframes rdx-pm-enter {
  from {
    opacity: 0;
    transform: translateX(-14px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.rdx-payment-mode.is-entering .rdx-pm-kpi {
  animation: rdx-pm-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: calc(var(--rdx-pm-i, 0) * 90ms);
}

@media (prefers-reduced-motion: reduce) {
  .rdx-payment-mode.is-pending .rdx-pm-kpi {
    opacity: 1;
    transform: none;
  }

  .rdx-payment-mode.is-entering .rdx-pm-kpi {
    animation: none;
  }
}

.rdx-pm-kpi-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #94a3b8;
  margin-bottom: 8px;
}

.rdx-pm-kpi-value {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.rdx-pm-kpi-digital .rdx-pm-kpi-value { color: #2563eb; }
.rdx-pm-kpi-cash .rdx-pm-kpi-value { color: #34d399; }
.rdx-pm-kpi-credit .rdx-pm-kpi-value { color: #f59e0b; }

.rdx-pm-kpi-trend {
  margin-top: 8px;
  font-size: 13px;
  font-weight: 600;
}

.rdx-pm-kpi-trend.up { color: #16a34a; }
.rdx-pm-kpi-trend.down { color: #dc2626; }

@media (max-width: 900px) {
  .rdx-pm-body {
    grid-template-columns: 1fr;
  }

  .rdx-pm-kpis {
    flex-direction: row;
  }

  .rdx-pm-kpi {
    flex: 1;
  }
}

@media (max-width: 560px) {
  .rdx-pm-kpis {
    flex-direction: column;
  }
}

.rdx-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.rdx-card-head h2 {
  margin: 0;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #334155;
}

.rdx-card-head p {
  margin: 4px 0 0;
  font-size: 12px;
  color: #94a3b8;
  font-weight: 500;
}

.rdx-date {
  height: 36px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #fff;
  padding: 0 10px;
  font: 600 12px Inter, system-ui, sans-serif;
  color: #334155;
}

.rdx-chart {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 280px;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}
.rdx-chart-sm { min-height: 220px; }
.rdx-chart-lg { min-height: 360px; }

.rdx-leaderboard {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rdx-loc-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
}

.rdx-rank {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 800;
  background: #eff6ff;
  color: #2563eb;
}

.rdx-loc-name {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
}

.rdx-loc-meta {
  font-size: 11px;
  color: #64748b;
  margin-top: 2px;
}

.rdx-loc-stats {
  text-align: right;
  font-size: 12px;
  font-weight: 700;
  color: #334155;
}

.rdx-insights {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rdx-insight {
  display: flex;
  gap: 10px;
  padding: 12px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
}

.rdx-insight.positive { border-left: 3px solid #22c55e; }
.rdx-insight.warning { border-left: 3px solid #f59e0b; }
.rdx-insight.neutral { border-left: 3px solid #2563eb; }

.rdx-insight strong {
  display: block;
  font-size: 12px;
  color: #0f172a;
  margin-bottom: 3px;
}

.rdx-insight span {
  font-size: 12px;
  color: #64748b;
}

.rdx-forecast-card {
  padding: 18px;
  border-radius: 14px;
  background: linear-gradient(135deg, #eff6ff 0%, #f5f3ff 100%);
  border: 1px solid #dbeafe;
  margin-bottom: 12px;
}

.rdx-forecast-card .val {
  font-size: 26px;
  font-weight: 800;
  color: #1e3a8a;
}

.rdx-table-wrap { overflow-x: auto; }

.rdx-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.rdx-table th,
.rdx-table td {
  padding: 10px 12px;
  text-align: left;
  border-bottom: 1px solid #eef2f7;
}

.rdx-table th {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #94a3b8;
}

.rdx-table td.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

@media (max-width: 1100px) {
  .rdx-grid-2:not(.rdx-grid-top-items):not(.rdx-grid-heatmap-payment):not(.rdx-grid-dow-heat),
  .rdx-grid-3 { grid-template-columns: 1fr; }
}

@media (max-width: 760px) {
  .rdx-content { padding: 14px 14px 40px; }
  .rdx-hero h1 { font-size: 22px; }
}


/* Phone compact analytics — preserve desktop grids above */
.rdx-content,
.rdx-card,
.rdx-grid-2,
.rdx-grid-3,
.rdx-chart,
.rdx-chart-sales,
.rdx-pm-chart,
.rdx-heatmap-scroll{
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

@media (max-width: 640px) {
  .rdx-content{
    padding: 12px 12px 36px;
  }
  .rdx-sales-trend{
    padding: 16px 14px 14px;
    border-radius: 16px;
  }
  .rdx-st-title{
    letter-spacing: 0.06em;
  }
  .rdx-st-stats{
    gap: 10px;
    margin-bottom: 16px;
  }
  .rdx-st-stat{
    padding: 12px 12px;
  }
  .rdx-st-stat-value{
    font-size: 18px;
  }
  .rdx-chart-sales{
    min-height: 240px;
  }
  .rdx-chart{
    min-height: 220px;
  }
  .rdx-chart-sm{
    min-height: 200px;
  }
  .rdx-co-leaderboard,
  .rdx-sales-contrib,
  .rdx-payment-mode{
    padding: 16px 14px;
    border-radius: 16px;
  }
  .rdx-pm-chart{
    min-height: 220px;
  }
  .rdx-pm-kpi-value{
    font-size: 28px;
  }
  .rdx-sales-heatmap-card{
    padding: 14px;
  }
  .rdx-heatmap{
    grid-template-columns: minmax(64px, max-content) repeat(7, minmax(0, 1fr));
    gap: 4px;
  }
  .rdx-sc-chart-wrap{
    max-width: min(200px, 70vw);
  }
}

@media (max-width: 430px) {
  .rdx-content{
    padding: 10px 10px 32px;
  }
  .rdx-st-stats{
    grid-template-columns: 1fr;
  }
  .rdx-pm-kpis{
    flex-direction: column;
  }
  .rdx-co-foot{
    flex-direction: column;
    gap: 6px;
  }
  .rdx-chart-sales{
    min-height: 220px;
  }
}


.rdx-grid-sankey-alone {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
  margin-bottom: 16px;
}

.rdx-grid-sankey-alone > .rdx-financial-flow {
  width: 100%;
  margin-bottom: 0;
}

/* Sankey financial flow — Hotel Business card */
.rdx-financial-flow {
  border-radius: 18px;
  border: 1px solid #e8eef5;
  padding: 22px 24px 18px;
  background: #ffffff;
  box-shadow: 0 6px 24px rgba(15, 23, 42, 0.04);
}

.rdx-ff-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.rdx-ff-head-text {
  min-width: 0;
}

.rdx-ff-title {
  margin: 0;
  font-family: Inter, Poppins, system-ui, sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f2744;
  text-transform: none;
}

.rdx-ff-subtitle {
  margin: 4px 0 0;
  font-size: 14px;
  font-weight: 600;
  color: #64748b;
}

.rdx-ff-tagline {
  margin: 2px 0 0;
  font-size: 12px;
  font-weight: 500;
  color: #94a3b8;
}

.rdx-ff-date {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin: 2px 0 0;
  padding: 9px 12px;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #334155;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  transition: background 0.15s ease, border-color 0.15s ease;
}

.rdx-ff-date:hover {
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.rdx-ff-date-icon {
  width: 16px;
  height: 16px;
  color: #64748b;
}

.rdx-ff-date-chevron {
  width: 14px;
  height: 14px;
  color: #94a3b8;
}

.rdx-ff-date-label {
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.rdx-ff-stages {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin: 0 0 12px;
}

.rdx-ff-stage {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid transparent;
}

.rdx-ff-stage--revenue {
  background: #eff6ff;
  border-color: #dbeafe;
}

.rdx-ff-stage--costs {
  background: #fff7ed;
  border-color: #ffedd5;
}

.rdx-ff-stage--output {
  background: #ecfdf5;
  border-color: #d1fae5;
}

.rdx-ff-stage-kicker {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #475569;
}

.rdx-ff-stage--revenue .rdx-ff-stage-kicker { color: #1d4ed8; }
.rdx-ff-stage--costs .rdx-ff-stage-kicker { color: #c2410c; }
.rdx-ff-stage--output .rdx-ff-stage-kicker { color: #047857; }

.rdx-ff-stage-desc {
  font-size: 12px;
  font-weight: 500;
  color: #64748b;
  line-height: 1.35;
}

.rdx-ff-chart {
  position: relative;
  width: 100%;
  min-height: 560px;
  height: auto;
  box-sizing: border-box;
  border-radius: 14px;
  background: linear-gradient(180deg, #fbfcfe 0%, #ffffff 55%);
  border: 1px solid #f1f5f9;
  overflow: visible;
  padding: 8px 4px 12px;
}

.rdx-ff-layout {
  position: relative;
  width: 100%;
  min-height: inherit;
}

.rdx-ff-links {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: visible;
}

.rdx-ff-cols {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(132px, 0.85fr) minmax(148px, 0.95fr) minmax(340px, 2.35fr);
  gap: 18px 26px;
  align-items: stretch;
  width: 100%;
  min-height: 520px;
  padding: 6px 8px 10px;
  box-sizing: border-box;
}

.rdx-ff-col {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 14px;
  min-width: 0;
}

.rdx-ff-col--total {
  justify-content: center;
}

.rdx-ff-col--right {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 16px;
  min-width: 0;
}

.rdx-ff-row {
  display: grid;
  grid-template-columns: minmax(140px, 0.95fr) minmax(168px, 1.15fr);
  gap: 18px 24px;
  align-items: center;
  min-width: 0;
}

.rdx-ff-row--purchase {
  align-items: center;
}

.rdx-ff-row--expense {
  align-items: center;
}

.rdx-ff-row--output {
  margin-top: auto;
  padding-top: 8px;
  align-items: center;
}

.rdx-ff-hub,
.rdx-ff-leaves {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.rdx-ff-hub {
  justify-content: center;
}

.rdx-ff-leaves--output {
  gap: 12px;
}

.rdx-ff-node {
  position: relative;
  display: flex;
  align-items: stretch;
  min-height: 64px;
  border-radius: 12px;
  border: 1px solid #e8eef5;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.rdx-ff-node-stripe {
  width: 5px;
  flex-shrink: 0;
}

.rdx-ff-node-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
  padding: 10px 12px;
  min-width: 0;
  flex: 1 1 auto;
}

.rdx-ff-node-name {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.rdx-ff-node-amt {
  font-size: 14px;
  font-weight: 800;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.015em;
  line-height: 1.2;
}

.rdx-ff-node-pct {
  font-size: 11px;
  font-weight: 600;
  color: #94a3b8;
  line-height: 1.2;
}

.rdx-ff-node--source {
  background: #f8fbff;
}

.rdx-ff-node--hotel {
  background: #eff6ff;
  border-color: #dbeafe;
}

.rdx-ff-node--restaurant {
  background: #ecfdf5;
  border-color: #d1fae5;
}

.rdx-ff-node--bar {
  background: #f5f3ff;
  border-color: #ede9fe;
}

.rdx-ff-node--total {
  min-height: 110px;
  background: #ffffff;
  border: 2px solid #93c5fd;
  box-shadow: 0 8px 22px rgba(37, 99, 235, 0.1);
  align-self: center;
}

.rdx-ff-node--total .rdx-ff-node-name {
  font-size: 13px;
  font-weight: 700;
  color: #0f2744;
}

.rdx-ff-node--total .rdx-ff-node-amt {
  font-size: 20px;
  font-weight: 800;
  color: #1d4ed8;
}

.rdx-ff-node--total .rdx-ff-node-pct {
  color: #3b82f6;
  font-weight: 700;
}

.rdx-ff-node--purchase {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.rdx-ff-node--purchase .rdx-ff-node-amt { color: #1d4ed8; }

.rdx-ff-node--expense {
  background: #fff7ed;
  border-color: #fed7aa;
}

.rdx-ff-node--expense .rdx-ff-node-amt { color: #c2410c; }

.rdx-ff-node--pbt {
  background: #ecfdf5;
  border-color: #a7f3d0;
  min-height: 72px;
}

.rdx-ff-node--pbt .rdx-ff-node-amt { color: #047857; }

.rdx-ff-node--purchase-leaf {
  background: #f8fbff;
  border-color: #dbeafe;
  min-height: 56px;
}

.rdx-ff-node--expense-leaf {
  background: #fffaf5;
  border-color: #ffedd5;
  min-height: 56px;
}

.rdx-ff-node--tax {
  background: #f8fafc;
  border-color: #e2e8f0;
  min-height: 58px;
}

.rdx-ff-node--tax .rdx-ff-node-amt { color: #475569; }

.rdx-ff-node--net {
  background: #d1fae5;
  border-color: #6ee7b7;
  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.12);
  min-height: 72px;
}

.rdx-ff-node--net .rdx-ff-node-name {
  font-weight: 800;
  color: #065f46;
}

.rdx-ff-node--net .rdx-ff-node-amt {
  font-size: 16px;
  color: #047857;
}

.rdx-ff-node--net .rdx-ff-node-pct {
  color: #059669;
  font-weight: 700;
}

.rdx-ff-node--loss {
  background: #fef2f2;
  border-color: #fecaca;
}

.rdx-ff-node--loss .rdx-ff-node-amt { color: #b91c1c; }

.rdx-ff-node--muted {
  background: #f8fafc;
  border-style: dashed;
}

@media (max-width: 1100px) {
  .rdx-ff-cols {
    grid-template-columns: minmax(120px, 0.85fr) minmax(130px, 0.95fr) minmax(300px, 2.3fr);
    gap: 14px 16px;
  }

  .rdx-ff-row {
    gap: 12px 16px;
  }

  .rdx-ff-node-amt { font-size: 13px; }
  .rdx-ff-node--total .rdx-ff-node-amt { font-size: 17px; }
}

@media (max-width: 900px) {
  .rdx-ff-head {
    flex-direction: column;
    align-items: stretch;
  }

  .rdx-ff-date {
    align-self: flex-start;
  }

  .rdx-ff-stages {
    grid-template-columns: 1fr;
  }

  .rdx-ff-chart {
    min-height: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .rdx-ff-cols {
    grid-template-columns: minmax(140px, 0.85fr) minmax(150px, 0.95fr) minmax(320px, 2.3fr);
    min-width: 760px;
  }

  .rdx-ff-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .rdx-ff-pct-note {
    white-space: normal;
  }
}

